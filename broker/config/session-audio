#!/usr/bin/python3
"""Private PipeWire graph and a reconnectable, bounded S16LE monitor socket."""
from collections import deque
import os
from pathlib import Path
import selectors
import signal
import socket
import subprocess
import time


BLOCK_BYTES = 3840  # 20 ms of stereo S16LE at 48 kHz


def relay_capture(connection, source):
    """Drain capture during client stalls, retaining at most three PCM blocks.

    A partly sent block must finish to preserve the byte stream's sample
    alignment. A small FIFO absorbs ordinary PipeWire quantum batching; only
    capture older than this 60 ms budget is replaced during backpressure.
    """
    connection.setsockopt(socket.SOL_SOCKET, socket.SO_SNDBUF, BLOCK_BYTES * 3)
    connection.setblocking(False)
    os.set_blocking(source.fileno(), False)
    partial = bytearray()
    queued = deque()
    offset = 0
    with selectors.DefaultSelector() as selector:
        selector.register(source, selectors.EVENT_READ)
        selector.register(connection, selectors.EVENT_READ)
        while True:
            # Register write interest only when there is data: otherwise a
            # healthy socket would spin continuously while capture is silent.
            selector.modify(connection, selectors.EVENT_READ |
                            (selectors.EVENT_WRITE if queued else 0))
            events = selector.select(timeout=0.1)
            ready = {key.fileobj: mask for key, mask in events}
            if ready.get(connection, 0) & selectors.EVENT_READ:
                try:
                    if not connection.recv(1):
                        return
                except BlockingIOError:
                    pass
            if ready.get(source, 0) & selectors.EVENT_READ:
                # Bound each drain turn so disconnects remain responsive even
                # when a producer is faster than real-time.
                for _ in range(64):
                    try:
                        data = os.read(source.fileno(), BLOCK_BYTES * 16)
                    except BlockingIOError:
                        break
                    if not data:
                        return
                    partial.extend(data)
                    complete = len(partial) // BLOCK_BYTES
                    if complete:
                        for position in range(complete):
                            queued.append(bytes(partial[position * BLOCK_BYTES:(position + 1) * BLOCK_BYTES]))
                            if len(queued) > 3:
                                # Finish a partly written front block, dropping
                                # its oldest unsent successor when overloaded.
                                if offset:
                                    del queued[1]
                                else:
                                    queued.popleft()
                        del partial[:complete * BLOCK_BYTES]
            if queued:
                try:
                    sent = connection.send(queued[0][offset:])
                except BlockingIOError:
                    continue
                if sent == 0:
                    return
                offset += sent
                if offset == len(queued[0]):
                    queued.popleft()
                    offset = 0



def capture(connection, environment):
    # The broker connects before Wayland startup and RDP audio negotiation.
    # Wait for the frontend to be ready rather than filling its socket with
    # silence (or timing out) while the desktop is still being bound.
    try:
        if connection.recv(1) != b"A":
            connection.close()
            return
    except OSError:
        connection.close()
        return
    process = subprocess.Popen([
        "/usr/bin/parec", "--raw", "--format=s16le", "--rate=48000",
        "--channels=2", "--device=niri-rdp-sink.monitor", "--latency-msec=20",
    ], env=environment, stdout=subprocess.PIPE, bufsize=0, pipesize=4096)
    try:
        relay_capture(connection, process.stdout)
    except OSError:
        pass
    finally:
        connection.close()
        process.terminate()
        process.wait()
        process.stdout.close()


def main():
    runtime = Path(os.environ["NIRI_RDP_RUNTIME_DIR"])
    os.umask(0o077)
    configuration = runtime / "audio-config"
    configuration.mkdir()
    # Read distribution defaults, bypassing user configuration that might load
    # hardware devices or use the local desktop's sockets and saved routing.
    (configuration / "pipewire.conf").write_text(
        Path("/usr/share/pipewire/pipewire.conf").read_text().replace(
            "context.objects = [", '''context.objects = [
 { factory = adapter args = {
   factory.name = support.null-audio-sink
   node.name = niri-rdp-sink
   node.description = "Remote Desktop Audio"
   media.class = Audio/Sink
   audio.position = [ FL FR ]
   node.virtual = true
   node.always-process = true
   priority.session = 2000
 } }
'''))
    (configuration / "pipewire-pulse.conf").write_text(
        Path("/usr/share/pipewire/pipewire-pulse.conf").read_text())
    (configuration / "wireplumber.conf").write_text(
        Path("/usr/share/wireplumber/wireplumber.conf").read_text().replace(
            "wireplumber.profiles = {", '''wireplumber.profiles = {
 remote = {
  inherits = [ main ]
  hardware.audio = disabled
  hardware.bluetooth = disabled
  hardware.video-capture = disabled
 }
'''))
    environment = dict(os.environ, XDG_RUNTIME_DIR=str(runtime),
                       PIPEWIRE_RUNTIME_DIR=str(runtime), PIPEWIRE_REMOTE="pipewire-0",
                       PIPEWIRE_CONFIG_DIR=str(configuration),
                       WIREPLUMBER_CONFIG_DIR=str(configuration),
                       XDG_STATE_HOME=str(runtime / "audio-state"),
                       PULSE_SERVER="unix:" + str(runtime / "pulse/native"))
    processes = []
    def shutdown(*_):
        raise SystemExit(0)
    signal.signal(signal.SIGTERM, shutdown)
    signal.signal(signal.SIGINT, shutdown)
    try:
        for command in (["/usr/bin/pipewire"], ["/usr/bin/pipewire-pulse"],
                        ["/usr/bin/wireplumber", "--profile=remote"]):
            processes.append(subprocess.Popen(command, env=environment))
            if command == ["/usr/bin/pipewire"]:
                for _ in range(100):
                    if (runtime / "pipewire-0").exists():
                        break
                    if processes[-1].poll() is not None:
                        raise RuntimeError("private PipeWire exited")
                    time.sleep(0.05)
                else:
                    raise RuntimeError("private PipeWire startup timed out")
        for _ in range(100):
            if any(p.poll() is not None for p in processes):
                raise RuntimeError("private audio daemon exited")
            probe = subprocess.run(["/usr/bin/pactl", "list", "short", "sinks"],
                                   env=environment, capture_output=True, timeout=1)
            if probe.returncode == 0 and b"niri-rdp-sink" in probe.stdout:
                break
            time.sleep(0.05)
        else:
            raise RuntimeError("private audio sink unavailable")
        subprocess.run(["/usr/bin/pactl", "set-default-sink", "niri-rdp-sink"],
                       env=environment, check=True, timeout=2)
        with socket.socket(socket.AF_UNIX) as listener:
            listener.bind(str(runtime / "audio-0"))
            listener.listen(1)
            listener.settimeout(0.5)
            while all(p.poll() is None for p in processes):
                try:
                    connection, _ = listener.accept()
                except TimeoutError:
                    continue
                capture(connection, environment)
        raise RuntimeError("private audio daemon exited")
    finally:
        for process in reversed(processes):
            if process.poll() is None:
                process.terminate()
        for process in processes:
            try:
                process.wait(timeout=2)
            except subprocess.TimeoutExpired:
                process.kill()
                process.wait()


if __name__ == "__main__":
    main()
