#!/usr/bin/python3
"""Give the private bus the remote display and start its configured portal."""
import os
from pathlib import Path
import subprocess
import time


def bus_owner(name, environment, timeout=2):
    result = subprocess.run([
        "/usr/bin/busctl", "--address=" + environment["DBUS_SESSION_BUS_ADDRESS"],
        "--timeout=" + str(timeout), "call", "org.freedesktop.DBus", "/org/freedesktop/DBus",
        "org.freedesktop.DBus", "GetNameOwner", "s", name,
    ], env=environment, capture_output=True, text=True, timeout=timeout)
    return result.stdout.strip() if result.returncode == 0 else None


def replace_stale_backends(environment):
    # A startup application may have activated these before the display export.
    # In particular, GNOME exposes Settings only when display initialization fails.
    # Checking ownership does not activate unused backends or affect host routing.
    for backend in ("gnome", "gtk"):
        name = "org.freedesktop.impl.portal.desktop." + backend
        executable = "/usr/lib/xdg-desktop-portal-" + backend
        owner = bus_owner(name, environment)
        if owner is None or not Path(executable).is_file():
            continue
        process = subprocess.Popen([executable, "--replace"], env=environment)
        deadline = time.monotonic() + 5
        while (remaining := deadline - time.monotonic()) > 0:
            replacement = bus_owner(name, environment, timeout=min(2, remaining))
            if replacement is not None and replacement != owner:
                break
            if process.poll() is not None:
                raise RuntimeError("private " + backend + " portal replacement exited")
            time.sleep(0.05)
        else:
            raise RuntimeError("private " + backend + " portal replacement timed out")


def main():
    # Run as a Niri child: the compositor's socket now exists. Never import this
    # environment into the shared systemd user manager or the physical desktop.
    runtime = os.environ["NIRI_RDP_RUNTIME_DIR"]
    if os.environ.get("XDG_RUNTIME_DIR") != runtime:
        raise RuntimeError("portal startup requires the private runtime")
    if not os.environ.get("WAYLAND_DISPLAY") or not os.environ.get("DBUS_SESSION_BUS_ADDRESS"):
        raise RuntimeError("portal startup requires Niri's display and private bus")
    # Preserve the installed Niri chooser (e.g. GNOME/Nautilus); use our GTK
    # profile only when there is no host Niri portal configuration.
    environment = dict(os.environ, XDG_CURRENT_DESKTOP="niri:niri-rdp")
    variables = ("XDG_RUNTIME_DIR", "WAYLAND_DISPLAY", "DISPLAY", "NIRI_SOCKET",
                 "XDG_CURRENT_DESKTOP", "XDG_SESSION_TYPE", "XDG_SESSION_DESKTOP",
                 "PIPEWIRE_RUNTIME_DIR", "PIPEWIRE_REMOTE", "PULSE_SERVER")
    subprocess.run(["/usr/bin/dbus-update-activation-environment",
                    *(key + "=" + environment.get(key, "") for key in variables)],
                   env=environment, check=True)
    replace_stale_backends(environment)
    # Replace a frontend activated before the display was exported. Later
    # activation keeps the same host-first backend selection.
    os.execve("/usr/lib/xdg-desktop-portal", ["xdg-desktop-portal", "--replace"], environment)


if __name__ == "__main__":
    main()
