#!/bin/sh
# Only the root broker launches this fixed executable after switching UID.
set -eu
: "${NIRI_RDP_RUNTIME_DIR:?broker private session directory missing}"
# logind retains its genuine /run/user/UID registration. The compositor and
# applications use a private runtime so no local Wayland or desktop bus is reused.
export XDG_RUNTIME_DIR="$NIRI_RDP_RUNTIME_DIR"
export NIRI_BACKEND=headless
# This root-owned file contains one policy word, never executable shell code.
renderer=auto
if [ -f /etc/niri-rdp/renderer.conf ]; then
    IFS= read -r renderer < /etc/niri-rdp/renderer.conf || {
        echo 'cannot read /etc/niri-rdp/renderer.conf' >&2
        exit 1
    }
fi
case "$renderer" in
    auto|hardware) unset LIBGL_ALWAYS_SOFTWARE GALLIUM_DRIVER ;;
    software) export LIBGL_ALWAYS_SOFTWARE=1 GALLIUM_DRIVER=llvmpipe ;;
    *) echo 'renderer.conf must contain auto, hardware or software' >&2; exit 1 ;;
esac
export NIRI_RDP_RENDERER="$renderer"
unset DISPLAY WAYLAND_DISPLAY WAYLAND_SOCKET NIRI_SOCKET SSH_AUTH_SOCK
# Reuse the user's desktop settings without starting the shared user services.
config=/etc/niri-rdp/headless.kdl
remote_config="${XDG_CONFIG_HOME:-$HOME/.config}/niri-rdp/config.kdl"
desktop_config="${XDG_CONFIG_HOME:-$HOME/.config}/niri/config.kdl"
if [ -f "$remote_config" ]; then
    config="$remote_config"
elif [ -f "$desktop_config" ]; then
    config="$NIRI_RDP_RUNTIME_DIR/config.kdl"
    # The include retains the original file's relative include paths (DMS
    # output/color snippets). Escape paths as KDL, including control characters.
    /usr/bin/python3 - "$desktop_config" "$config" <<'PY'
import pathlib
import sys
source = pathlib.Path(sys.argv[1]).absolute()
quoted = '"' + ''.join(
    '\\u{' + format(ord(char), 'x') + '}' if ord(char) < 32 else
    '\\"' if char == '"' else '\\\\' if char == '\\' else char
    for char in str(source)
) + '"'
pathlib.Path(sys.argv[2]).write_text(
    "include " + quoted + "\n"
    'output "HEADLESS-1" { scale 1; transform "normal"; }\n'
    'spawn-at-startup "/usr/lib/niri-rdp/session-desktop"\n'
)
PY
fi
exec /usr/lib/niri-rdp/niri-headless --config "$config"
