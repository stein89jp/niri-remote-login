#%PAM-1.0
# Dedicated remote login policy; never modify GDM, GRD or another PAM service.
#
# This stack is written out in full instead of including system-remote-login.
# It mirrors Arch pambase (system-login and system-auth) with two changes:
#
# 1. Only members of niri-rdp-users with a regular UID may authenticate. The
#    check is "required", not "requisite": the rest of the stack still runs,
#    so a correct password for root or a non-member fails after the same
#    pam_unix failure delay as a wrong password. That closes the timing
#    oracle. The broker repeats the group check after PAM.
# 2. pam_faillock uses a private tally directory and its own limits. Failed
#    RDP logins lock the account only for niri-rdp, never for the console,
#    sudo or other services. pam_faillock creates the directory on demand.
#    Reset an account with:
#      faillock --dir /run/faillock-niri-rdp --user NAME --reset
#
# Password expiration/MFA conversations are deliberately rejected by this v1
# broker, so there is no password stack.
auth      required                    pam_succeed_if.so    uid >= 1000 user ingroup niri-rdp-users quiet
auth      required                    pam_shells.so
auth      requisite                   pam_nologin.so
auth      required                    pam_faillock.so      preauth dir=/run/faillock-niri-rdp deny=5 unlock_time=300
-auth     [success=2 default=ignore]  pam_systemd_home.so
auth      [success=1 default=bad]     pam_unix.so          try_first_pass nullok
auth      [default=die]               pam_faillock.so      authfail dir=/run/faillock-niri-rdp deny=5 unlock_time=300
auth      optional                    pam_permit.so
auth      required                    pam_env.so
auth      required                    pam_faillock.so      authsucc dir=/run/faillock-niri-rdp deny=5 unlock_time=300

account   required                    pam_access.so
account   required                    pam_nologin.so
-account  [success=1 default=ignore]  pam_systemd_home.so
account   required                    pam_unix.so
account   optional                    pam_permit.so
account   required                    pam_time.so

session   required                    pam_loginuid.so
session   optional                    pam_keyinit.so       force revoke
-session  optional                    pam_systemd_home.so
session   required                    pam_limits.so
session   required                    pam_unix.so
session   optional                    pam_permit.so
session   optional                    pam_umask.so
session   required                    pam_systemd.so       type=wayland class=user desktop=niri
