[Unit]
Description=Niri Remote Login PAM session broker
After=systemd-logind.service
Requires=systemd-logind.service

[Service]
Type=simple
User=root
Group=niri-rdp
ExecStartPre=/usr/lib/niri-rdp/prepare-tls
ExecStart=/usr/lib/niri-rdp/niri-rdp-broker
ExecStopPost=/usr/lib/niri-rdp/niri-rdp-broker --cleanup
Restart=on-failure
RestartSec=2
RuntimeDirectory=niri-rdp
# Bubblewrap opens runtime ancestors for reading when mounting D-Bus proxies.
# Session records and each user's desktop remain private (0700).
RuntimeDirectoryMode=0755
# Preserve crash session records until ExecStopPost handles them.
RuntimeDirectoryPreserve=yes
KillMode=control-group
TimeoutStopSec=30
# The broker drops both for itself; desktops get the PAM session's umask
# (or 022) and a core limit of 0/unlimited before switching to the user.
LimitCORE=0
UMask=0077
# No PrivateTmp: desktops inherit this mount namespace and, like sshd and
# GDM sessions, must share /tmp with the user's other logins.
# Session children inherit mount namespaces. Keep their homes writable.
# A stricter broker mount namespace requires a separate worker launch service.
# PAM opens a logind scope and performs credential switching: do not add
# PrivateUsers, NoNewPrivileges, or restrictive capabilities without VM tests.

[Install]
WantedBy=multi-user.target
