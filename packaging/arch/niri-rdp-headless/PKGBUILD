# Standalone patched binary: does not replace the installed /usr/bin/niri.
# The niri-remote-login bridge requires this rebased series (ext-image-copy-capture
# cursor sessions with patch 0011, no_keymap virtual keyboards); it depends on
# niri-rdp-headless>=26.04.remote2-1, so both packages must be upgraded together.
pkgname=niri-rdp-headless
pkgver=26.04.remote2
pkgrel=2
pkgdesc='Niri main with the rebased PR3953 headless backend for isolated remote-login sessions'
arch=('x86_64')
license=('GPL-3.0-or-later')
options=('!debug' '!lto')
depends=('seatd' 'libinput' 'libdisplay-info' 'mesa' 'libglvnd' 'wayland' 'libxkbcommon' 'pango' 'cairo' 'pixman' 'systemd-libs')
makedepends=('rust' 'cargo' 'git' 'gcc' 'pkgconf' 'python')
_revision=fc9e8c425e2267d877a65918f030c86f3c698179
_patches=(0001-headless-backend.patch
          0002-fail-closed-startup.patch
          0003-output-bounds.patch
          0004-output-mode-change.patch
          0005-egl-device-selection.patch
          0006-dmabuf-feedback.patch
          0007-private-startup-hook.patch
          0008-keyboard-layout-group-sync.patch
          0009-unicode-keymap-restore.patch
          0010-remote-input-regressions.patch
          0011-cursor-motion-echo.patch
          0012-cursor-dnd-icon.patch
          0013-headless-frame-pacing.patch)
source=("niri-$_revision.tar.gz::https://codeload.github.com/niri-wm/niri/tar.gz/$_revision"
        "${_patches[@]}"
        'collect-licenses.py')
# Patch and script hashes are filled by scripts/prepare-release.py after source validation.
sha256sums=('d7e8b62923429eba4187990cb94a9466e3df8840632f6302cd1c0fe20fa450d9'
            '@SHA256:0001-headless-backend.patch@'
            '@SHA256:0002-fail-closed-startup.patch@'
            '@SHA256:0003-output-bounds.patch@'
            '@SHA256:0004-output-mode-change.patch@'
            '@SHA256:0005-egl-device-selection.patch@'
            '@SHA256:0006-dmabuf-feedback.patch@'
            '@SHA256:0007-private-startup-hook.patch@'
            '@SHA256:0008-keyboard-layout-group-sync.patch@'
            '@SHA256:0009-unicode-keymap-restore.patch@'
            '@SHA256:0010-remote-input-regressions.patch@'
            '@SHA256:0011-cursor-motion-echo.patch@'
            '@SHA256:0012-cursor-dnd-icon.patch@'
            '@SHA256:0013-headless-frame-pacing.patch@'
            '@SHA256:collect-licenses.py@')

prepare() {
  cd "$srcdir/niri-$_revision"
  # Files created by the series survive re-extraction into a reused src tree.
  local generated previous patch_file
  for generated in docs/Virtual-Outputs.md src/utils/private_startup.rs src/tests/remote_input.rs src/tests/cursor_capture.rs; do
    if [[ -f $generated ]]; then
      previous=$(mktemp -d "$srcdir/niri-rdp-previous-patch.XXXXXX")
      mv "$generated" "$previous/${generated##*/}"
    fi
  done
  for patch_file in "${_patches[@]}"; do
    patch -Np1 -i "$srcdir/$patch_file"
  done
  export CARGO_HOME="$srcdir/cargo-home"
  cargo fetch --locked
  python "$srcdir/collect-licenses.py" Cargo.toml THIRD-PARTY-NOTICES.txt
}

build() {
  cd "$srcdir/niri-$_revision"
  export CARGO_HOME="$srcdir/cargo-home"
  cargo build --release --locked --offline --no-default-features --bin niri
}

check() {
  cd "$srcdir/niri-$_revision"
  export CARGO_HOME="$srcdir/cargo-home"
  # Headless startup and software-renderer tests need Mesa's EGL (llvmpipe).
  cargo test --locked --offline --no-default-features --lib backend::headless
  local input_runtime
  input_runtime=$(mktemp -d "$srcdir/input-tests.XXXXXX")
  # Remote input, cursor-session and private-startup regressions from the series.
  XDG_RUNTIME_DIR="$input_runtime" cargo test --locked --offline --no-default-features --lib -- \
    tests::remote_input tests::cursor_capture utils::private_startup
}

package() {
  cd "$srcdir/niri-$_revision"
  install -Dm755 "${CARGO_TARGET_DIR:-$srcdir/niri-$_revision/target}/release/niri" "$pkgdir/usr/lib/niri-rdp/niri-headless"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 THIRD-PARTY-NOTICES.txt "$pkgdir/usr/share/licenses/$pkgname/THIRD-PARTY-NOTICES.txt"
}
