+    #[test]
+    fn delayed_input_method_preserves_physical_unicode_physical_burst_order() {
+        let mut config = Config::default();
+        config.input.keyboard.xkb.layout = "us".into();
+        let mut event_loop = EventLoop::<State>::try_new().unwrap();
+        let mut state = State::new(
+            config,
+            event_loop.handle(),
+            event_loop.get_signal(),
+            Display::new().unwrap(),
+            true,
+            false,
+            false,
+        )
+        .unwrap();
+        let (server, peer) = UnixStream::pair().unwrap();
+        state.niri.insert_client(NewClient {
+            client: server,
+            restricted: false,
+            credentials_unknown: false,
+        });
+        let (ready_tx, ready_rx) = mpsc::channel();
+        let (continue_tx, continue_rx) = mpsc::channel();
+        let (done_tx, done_rx) = mpsc::channel();
+        let input_method = std::thread::spawn(move || {
+            let connection = Connection::from_socket(peer).unwrap();
+            let mut queue = connection.new_event_queue::<GrabProbe>();
+            let handle = queue.handle();
+            let mut probe = GrabProbe::default();
+            connection.display().get_registry(&handle, ());
+            queue.roundtrip(&mut probe).unwrap();
+            let method = probe.manager.as_ref().unwrap().get_input_method(
+                probe.seat.as_ref().unwrap(),
+                &handle,
+                (),
+            );
+            let _old_grab = method.grab_keyboard(&handle, ());
+            queue.roundtrip(&mut probe).unwrap();
+            // An older initialized resource remains present. The compositor
+            // must update the new grab, rather than choosing an arbitrary one.
+            let grab = method.grab_keyboard(&handle, ());
+            probe.active_grab = Some(grab.id().protocol_id());
+            queue.roundtrip(&mut probe).unwrap();
+            ready_tx.send(()).unwrap();
+            // Hold the input method while the whole RDP-style burst is queued.
+            continue_rx.recv().unwrap();
+            queue.roundtrip(&mut probe).unwrap();
+            done_tx.send(probe.text).unwrap();
+        });
+        let deadline = Instant::now() + Duration::from_secs(5);
+        while ready_rx.try_recv().is_err() {
+            assert!(
+                Instant::now() < deadline,
+                "input method initialization timed out"
+            );
+            event_loop
+                .dispatch(Some(Duration::from_millis(10)), &mut state)
+                .unwrap();
+            state.refresh_and_flush_clients();
+        }
+        fn physical(state: &mut State, key: u32, value: KeyState) {
+            input_method::sync_canonical_keymap(state);
+            state.on_keyboard_key((key + 8).into(), value, 0, &mut false);
+        }
+        physical(&mut state, 30, KeyState::Pressed);
+        physical(&mut state, 30, KeyState::Released);
+        let data = KeyboardData::default();
+        for character in "Phone@\"日本😀".chars() {
+            remember_keymap(&data, &unicode_map(character)).unwrap();
+            assert!(
+                sync_submitted_keymap(&state, &data),
+                "new grab resource must be tracked"
+            );
+            committed_key(&mut state, &data, 1, 247, KeyState::Pressed);
+            committed_key(&mut state, &data, 2, 247, KeyState::Released);
+            input_method::sync_canonical_keymap(&mut state);
+        }
+        for (key, value) in [
+            (42, KeyState::Pressed),
+            (30, KeyState::Pressed),
+            (30, KeyState::Released),
+            (42, KeyState::Released),
+            (30, KeyState::Pressed),
+            (30, KeyState::Released),
+        ] {
+            physical(&mut state, key, value);
+        }
+        state.refresh_and_flush_clients();
+        continue_tx.send(()).unwrap();
+        let deadline = Instant::now() + Duration::from_secs(5);
+        let text = loop {
+            if let Ok(text) = done_rx.try_recv() {
+                break text;
+            }
+            assert!(Instant::now() < deadline, "input method burst timed out");
+            event_loop
+                .dispatch(Some(Duration::from_millis(10)), &mut state)
+                .unwrap();
+            state.refresh_and_flush_clients();
+        };
+        input_method.join().unwrap();
+        assert_eq!(text, "aPhone@\"日本😀Aa");
+    }
