diff --git a/src/protocols/input_method.rs b/src/protocols/input_method.rs
new file mode 100644
--- /dev/null
+++ b/src/protocols/input_method.rs
@@ -0,0 +1,358 @@
+//! Keep input-method forwarded keys out of the input method's own grab.
+use std::sync::{Arc, Mutex};
+
+use smithay::backend::input::{KeyState, Keycode};
+use smithay::input::keyboard::{
+    xkb, GrabStartData, KeyboardGrab, KeyboardInnerHandle, KeymapFile, ModifiersState,
+};
+use smithay::reexports::wayland_protocols_misc::zwp_input_method_v2::server::{
+    zwp_input_method_keyboard_grab_v2::ZwpInputMethodKeyboardGrabV2,
+    zwp_input_method_manager_v2::ZwpInputMethodManagerV2,
+    zwp_input_method_v2::{self, ZwpInputMethodV2},
+    zwp_input_popup_surface_v2::ZwpInputPopupSurfaceV2,
+};
+use smithay::reexports::wayland_server::{
+    backend::ClientId, delegate_dispatch, delegate_global_dispatch, Client, DataInit, Dispatch,
+    DisplayHandle, Resource,
+};
+use smithay::utils::{Serial, SERIAL_COUNTER};
+use smithay::wayland::input_method::{
+    InputMethodKeyboardGrab, InputMethodKeyboardUserData, InputMethodManagerGlobalData,
+    InputMethodManagerState, InputMethodPopupSurfaceUserData, InputMethodUserData,
+};
+
+use crate::niri::State;
+
+delegate_global_dispatch!(State: [ZwpInputMethodManagerV2: InputMethodManagerGlobalData] => InputMethodManagerState);
+delegate_dispatch!(State: [ZwpInputMethodManagerV2: ()] => InputMethodManagerState);
+delegate_dispatch!(State: [ZwpInputMethodKeyboardGrabV2: InputMethodKeyboardUserData<State>] => InputMethodManagerState);
+delegate_dispatch!(State: [ZwpInputPopupSurfaceV2: InputMethodPopupSurfaceUserData] => InputMethodManagerState);
+
+struct InputMethodGrab {
+    owner: ClientId,
+    inner: InputMethodKeyboardGrab,
+    resource: Option<ZwpInputMethodKeyboardGrabV2>,
+    keymap: Arc<Mutex<String>>,
+}
+
+impl KeyboardGrab<State> for InputMethodGrab {
+    fn input(
+        &mut self,
+        state: &mut State,
+        handle: &mut KeyboardInnerHandle<'_, State>,
+        key: Keycode,
+        value: KeyState,
+        modifiers: Option<ModifiersState>,
+        serial: Serial,
+        time: u32,
+    ) {
+        self.inner
+            .input(state, handle, key, value, modifiers, serial, time);
+    }
+
+    fn set_focus(
+        &mut self,
+        state: &mut State,
+        handle: &mut KeyboardInnerHandle<'_, State>,
+        focus: Option<<State as smithay::input::SeatHandler>::KeyboardFocus>,
+        serial: Serial,
+    ) {
+        self.inner.set_focus(state, handle, focus, serial);
+    }
+
+    fn start_data(&self) -> &GrabStartData<State> {
+        self.inner.start_data()
+    }
+
+    fn unset(&mut self, state: &mut State) {
+        self.inner.unset(state);
+    }
+}
+
+pub(super) fn owns_keyboard_grab(state: &State, client: &ClientId) -> bool {
+    state
+        .niri
+        .seat
+        .get_keyboard()
+        .unwrap()
+        .with_grab(|_, grab| {
+            grab.downcast_ref::<InputMethodGrab>()
+                .is_some_and(|grab| &grab.owner == client)
+        })
+        .unwrap_or(false)
+}
+
+pub(super) fn sync_keymap(
+    state: &State,
+    text: &str,
+    file: &KeymapFile,
+    modifiers: [u32; 4],
+) -> bool {
+    let keyboard = state.niri.seat.get_keyboard().unwrap();
+    let grab = keyboard
+        .with_grab(|_, grab| {
+            grab.downcast_ref::<InputMethodGrab>().and_then(|grab| {
+                grab.resource
+                    .as_ref()
+                    .filter(|resource| resource.is_alive())
+                    .map(|resource| (resource.clone(), grab.keymap.clone()))
+            })
+        })
+        .flatten();
+    let Some((resource, cached)) = grab else {
+        return false;
+    };
+    let mut cached = cached.lock().unwrap();
+    if *cached != text {
+        let sent = file.with_fd(true, |fd, size| {
+            resource.keymap(
+                smithay::reexports::wayland_server::protocol::wl_keyboard::KeymapFormat::XkbV1,
+                fd,
+                size as u32,
+            )
+        });
+        if let Err(error) = sent {
+            warn!("could not update input-method grab keymap: {error}");
+            return false;
+        }
+        *cached = text.to_owned();
+    }
+    let [depressed, latched, locked, group] = modifiers;
+    resource.modifiers(
+        SERIAL_COUNTER.next_serial().into(),
+        depressed,
+        latched,
+        locked,
+        group,
+    );
+    true
+}
+
+pub(super) fn sync_canonical_keymap(state: &mut State) {
+    let keyboard = state.niri.seat.get_keyboard().unwrap();
+    let (text, file) = keyboard.with_xkb_state(state, |context| {
+        let current = context.xkb().lock().unwrap();
+        let keymap = unsafe { current.keymap() };
+        (
+            keymap.get_as_string(xkb::KEYMAP_FORMAT_TEXT_V1),
+            KeymapFile::new(keymap),
+        )
+    });
+    let mods = keyboard.modifier_state().serialized;
+    sync_keymap(
+        state,
+        &text,
+        &file,
+        [
+            mods.depressed,
+            mods.latched,
+            mods.locked,
+            mods.layout_effective,
+        ],
+    );
+}
+
+fn grab_objects(
+    handle: &DisplayHandle,
+    client: &Client,
+    initialized: bool,
+) -> Vec<ZwpInputMethodKeyboardGrabV2> {
+    let mut objects = Vec::new();
+    // Collect IDs first: querying another backend method inside this callback
+    // would deadlock its object-map lock.
+    let _ = handle
+        .backend_handle()
+        .with_all_objects_for(client.id(), |id| {
+            if id.interface().name == ZwpInputMethodKeyboardGrabV2::interface().name {
+                objects.push(id);
+            }
+        });
+    objects
+        .into_iter()
+        .filter_map(|id| ZwpInputMethodKeyboardGrabV2::from_id(handle, id).ok())
+        .filter(|resource| {
+            !initialized
+                || resource
+                    .data::<InputMethodKeyboardUserData<State>>()
+                    .is_some()
+        })
+        .collect()
+}
+
+pub(super) fn forward_key(
+    state: &mut State,
+    client: &ClientId,
+    data: &super::virtual_keyboard::KeyboardData,
+    key: Keycode,
+    value: KeyState,
+    time: u32,
+) -> bool {
+    if !owns_keyboard_grab(state, client) {
+        return false;
+    }
+    // The original physical event already updated XKB and checked bindings.
+    // Only bypass the grab for keys from its owning input-method connection.
+    super::virtual_keyboard::direct_key(
+        state,
+        data,
+        time,
+        key.raw() - 8,
+        if value == KeyState::Pressed { 1 } else { 0 },
+    );
+    true
+}
+
+impl Dispatch<ZwpInputMethodV2, InputMethodUserData<State>> for State {
+    fn request(
+        state: &mut Self,
+        client: &Client,
+        resource: &ZwpInputMethodV2,
+        request: zwp_input_method_v2::Request,
+        data: &InputMethodUserData<State>,
+        handle: &DisplayHandle,
+        data_init: &mut DataInit<'_, Self>,
+    ) {
+        let grabbing = matches!(request, zwp_input_method_v2::Request::GrabKeyboard { .. });
+        let previous = if grabbing {
+            grab_objects(handle, client, true)
+        } else {
+            Vec::new()
+        };
+        <InputMethodManagerState as Dispatch<_, _, State>>::request(
+            state, client, resource, request, data, handle, data_init,
+        );
+        if grabbing {
+            let keyboard = state.niri.seat.get_keyboard().unwrap();
+            let grab = keyboard
+                .with_grab(|serial, grab| {
+                    grab.downcast_ref::<InputMethodKeyboardGrab>()
+                        .map(|grab| (serial, grab.clone()))
+                })
+                .flatten();
+            if let Some((serial, inner)) = grab {
+                // DataInit commits userdata after this callback returns. The
+                // new object is allocated already, but cannot pass a data filter.
+                let resource = grab_objects(handle, client, false)
+                    .into_iter()
+                    .find(|resource| !previous.contains(resource));
+                let text = keyboard.with_xkb_state(state, |context| {
+                    let current = context.xkb().lock().unwrap();
+                    unsafe { current.keymap() }.get_as_string(xkb::KEYMAP_FORMAT_TEXT_V1)
+                });
+                keyboard.set_grab(
+                    state,
+                    InputMethodGrab {
+                        owner: client.id(),
+                        inner,
+                        resource,
+                        keymap: Arc::new(Mutex::new(text)),
+                    },
+                    serial,
+                );
+            }
+        }
+    }
+
+    fn destroyed(
+        state: &mut Self,
+        client: ClientId,
+        resource: &ZwpInputMethodV2,
+        data: &InputMethodUserData<State>,
+    ) {
+        <InputMethodManagerState as Dispatch<_, _, State>>::destroyed(
+            state, client, resource, data,
+        );
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use std::os::unix::net::UnixStream;
+
+    use calloop::EventLoop;
+    use niri_config::Config;
+    use smithay::reexports::wayland_server::Display;
+
+    use super::*;
+
+    #[test]
+    fn forwarded_keys_bypass_only_the_owning_grab_without_updating_xkb() {
+        let event_loop = EventLoop::<State>::try_new().unwrap();
+        let mut state = State::new(
+            Config::default(),
+            event_loop.handle(),
+            event_loop.get_signal(),
+            Display::new().unwrap(),
+            true,
+            false,
+            false,
+        )
+        .unwrap();
+        let (socket, _peer) = UnixStream::pair().unwrap();
+        let client = state
+            .niri
+            .display_handle
+            .insert_client(socket, Arc::new(()))
+            .unwrap();
+        let (other_socket, _other_peer) = UnixStream::pair().unwrap();
+        let other = state
+            .niri
+            .display_handle
+            .insert_client(other_socket, Arc::new(()))
+            .unwrap();
+        let keyboard = state.niri.seat.get_keyboard().unwrap();
+        keyboard.set_grab(
+            &mut state,
+            InputMethodGrab {
+                owner: client.id(),
+                // This empty underlying grab would panic if a key re-entered it.
+                inner: InputMethodKeyboardGrab::default(),
+                resource: None,
+                keymap: Arc::new(Mutex::new(String::new())),
+            },
+            SERIAL_COUNTER.next_serial(),
+        );
+        let original = keyboard.modifier_state();
+        let data = super::super::virtual_keyboard::KeyboardData::default();
+        assert!(!forward_key(
+            &mut state,
+            &other.id(),
+            &data,
+            66u32.into(),
+            KeyState::Pressed,
+            0
+        ));
+        assert!(forward_key(
+            &mut state,
+            &client.id(),
+            &data,
+            66u32.into(),
+            KeyState::Pressed,
+            0
+        ));
+        assert!(forward_key(
+            &mut state,
+            &client.id(),
+            &data,
+            66u32.into(),
+            KeyState::Released,
+            1
+        ));
+        assert_eq!(
+            keyboard.modifier_state(),
+            original,
+            "Caps Lock must not be applied twice"
+        );
+        assert!(owns_keyboard_grab(&state, &client.id()));
+        keyboard.unset_grab(&mut state);
+        assert!(!owns_keyboard_grab(&state, &client.id()));
+        assert!(!forward_key(
+            &mut state,
+            &client.id(),
+            &data,
+            66u32.into(),
+            KeyState::Pressed,
+            2
+        ));
+    }
+}
