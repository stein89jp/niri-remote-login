+    pub fn create_dmabuf_global(&mut self, niri: &mut Niri) {
+        let Some(renderer) = self.renderer.as_ref() else {
+            return;
+        };
+        let display = renderer.egl_context().display();
+        let Ok(device) = EGLDevice::device_for_display(display) else {
+            return;
+        };
+        if device.is_software() {
+            return;
+        }
+        // Allow accelerated applications to submit GPU buffers rather than
+        // downloading every window to SHM before the compositor uploads it again.
+        let formats = renderer.dmabuf_formats();
+        if formats.iter().next().is_none() {
+            return;
+        }
+        let feedback = device
+            .try_get_render_node()
+            .ok()
+            .flatten()
+            .and_then(|node| {
+                DmabufFeedbackBuilder::new(node.dev_id(), formats.clone())
+                    .build()
+                    .ok()
+            });
+        if let Some(feedback) = feedback {
+            niri.dmabuf_state
+                .create_global_with_default_feedback::<State>(&niri.display_handle, &feedback);
+        } else {
+            niri.dmabuf_state
+                .create_global::<State>(&niri.display_handle, formats);
+        }
+        info!("headless renderer: advertised hardware DMA-BUF formats");
+    }
