+#[cfg(test)]
+mod remote_tests {
+    use calloop::EventLoop;
+    use niri_config::Config;
+    use smithay::reexports::wayland_server::Display;
+
+    use crate::niri::State;
+
+    #[test]
+    fn resize_preserves_output_identity_and_rejects_invalid_modes() {
+        let event_loop = EventLoop::<State>::try_new().unwrap();
+        let mut state = State::new(
+            Config::default(),
+            event_loop.handle(),
+            event_loop.get_signal(),
+            Display::new().unwrap(),
+            true,
+            false,
+            false,
+        )
+        .unwrap();
+        let name = state
+            .backend
+            .create_virtual_output(&mut state.niri, 1920, 1080, 60)
+            .unwrap();
+        let output = state.niri.global_space.outputs().next().unwrap().clone();
+        let id = *state
+            .backend
+            .ipc_outputs()
+            .lock()
+            .unwrap()
+            .keys()
+            .next()
+            .unwrap();
+        let ipc_name = {
+            let outputs = state.backend.ipc_outputs();
+            let outputs = outputs.lock().unwrap();
+            niri_config::OutputName::from_ipc_output(&outputs[&id])
+                .format_make_model_serial_or_connector()
+        };
+        assert!(output
+            .user_data()
+            .get::<niri_config::OutputName>()
+            .unwrap()
+            .matches(&ipc_name));
+        for (width, height, refresh) in [(1280, 720, 60.), (2560, 1440, 120.), (800, 600, 60.)] {
+            state.modify_output_config(&name, |config| {
+                config.mode = Some(niri_config::output::Mode {
+                    custom: true,
+                    mode: niri_ipc::ConfiguredMode {
+                        width,
+                        height,
+                        refresh: Some(refresh),
+                    },
+                });
+            });
+            state.reload_output_config();
+            assert_eq!(state.niri.global_space.outputs().next(), Some(&output));
+            assert_eq!(
+                output.current_mode().unwrap().size,
+                (i32::from(width), i32::from(height)).into()
+            );
+            assert_eq!(output.modes().len(), 1);
+            let ipc = state.backend.ipc_outputs();
+            let ipc = ipc.lock().unwrap();
+            assert_eq!(ipc.len(), 1);
+            assert_eq!(ipc[&id].modes[0].width, width);
+            assert_eq!(ipc[&id].modes[0].height, height);
+            assert_eq!(ipc[&id].modes[0].refresh_rate, (refresh * 1000.) as u32);
+            assert_eq!(ipc[&id].logical.as_ref().unwrap().width, u32::from(width));
+            assert_eq!(ipc[&id].logical.as_ref().unwrap().height, u32::from(height));
+            assert!(state.niri.ipc_outputs_changed);
+        }
+        let old_mode = output.current_mode();
+        let old_ipc =
+            serde_json::to_value(state.backend.ipc_outputs().lock().unwrap().get(&id)).unwrap();
+        for (width, height, refresh) in [
+            (0, 600, 60.),
+            (800, 0, 60.),
+            (8193, 600, 60.),
+            (800, 8193, 60.),
+            (800, 600, 0.),
+            (800, 600, 241.),
+            (800, 600, f64::NAN),
+        ] {
+            state.modify_output_config(&name, |config| {
+                config.mode = Some(niri_config::output::Mode {
+                    custom: true,
+                    mode: niri_ipc::ConfiguredMode {
+                        width,
+                        height,
+                        refresh: Some(refresh),
+                    },
+                });
+            });
+            state.reload_output_config();
+            assert_eq!(output.current_mode(), old_mode);
+            assert_eq!(
+                serde_json::to_value(state.backend.ipc_outputs().lock().unwrap().get(&id)).unwrap(),
+                old_ipc
+            );
+        }
+    }
+
+    #[test]
+    fn virtual_output_rejection_is_atomic_and_capacity_recovers_after_removal() {
+        let event_loop = EventLoop::<State>::try_new().unwrap();
+        let mut state = State::new(
+            Config::default(),
+            event_loop.handle(),
+            event_loop.get_signal(),
+            Display::new().unwrap(),
+            true,
+            false,
+            false,
+        )
+        .unwrap();
+        for (width, height, rate) in [
+            (0, 480, 60),
+            (640, 0, 60),
+            (8193, 480, 60),
+            (640, 8193, 60),
+            (640, 480, 0),
+            (640, 480, 241),
+        ] {
+            assert!(state
+                .backend
+                .create_virtual_output(&mut state.niri, width, height, rate)
+                .is_err());
+            assert_eq!(state.niri.global_space.outputs().count(), 0);
+            assert!(state.backend.ipc_outputs().lock().unwrap().is_empty());
+        }
+        let mut names = Vec::new();
+        for _ in 0..4 {
+            names.push(
+                state
+                    .backend
+                    .create_virtual_output(&mut state.niri, 640, 480, 60)
+                    .unwrap(),
+            );
+        }
+        assert_eq!(names[0], "HEADLESS-1");
+        assert!(state
+            .backend
+            .create_virtual_output(&mut state.niri, 640, 480, 60)
+            .is_err());
+        assert_eq!(state.niri.global_space.outputs().count(), 4);
+        state
+            .backend
+            .remove_virtual_output(&mut state.niri, &names[0])
+            .unwrap();
+        assert!(state
+            .backend
+            .remove_virtual_output(&mut state.niri, &names[0])
+            .is_err());
+        let replacement = state
+            .backend
+            .create_virtual_output(&mut state.niri, 640, 480, 60)
+            .unwrap();
+        assert_eq!(replacement, "HEADLESS-5");
+        names.remove(0);
+        names.push(replacement);
+        for name in names {
+            state
+                .backend
+                .remove_virtual_output(&mut state.niri, &name)
+                .unwrap();
+        }
+        assert_eq!(state.niri.global_space.outputs().count(), 0);
+        assert!(state.backend.ipc_outputs().lock().unwrap().is_empty());
+    }
+}
