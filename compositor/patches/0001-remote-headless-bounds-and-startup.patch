+    /// Apply client-selected modes without replacing the output or its workspaces.
+    pub fn on_output_config_changed(&mut self, niri: &mut Niri) {
+        for (output, output_id) in self.virtual_outputs.outputs.values() {
+            let configured = {
+                let config = niri.config.borrow();
+                let name = output.user_data().get::<OutputName>().unwrap();
+                config.outputs.find(name).and_then(|c| c.mode)
+            };
+            let Some(configured) = configured else {
+                continue;
+            };
+            let old_mode = output.current_mode().unwrap();
+            let requested = configured.mode;
+            let refresh = requested.refresh.unwrap_or(old_mode.refresh as f64 / 1000.);
+            // Apply the same allocation bounds as output creation before any mutation.
+            if requested.width == 0
+                || requested.height == 0
+                || requested.width > 8192
+                || requested.height > 8192
+                || !refresh.is_finite()
+                || !(1.0..=240.0).contains(&refresh)
+            {
+                warn!(
+                    "ignoring invalid headless output mode for {}",
+                    output.name()
+                );
+                continue;
+            }
+            let mode = Mode {
+                size: (i32::from(requested.width), i32::from(requested.height)).into(),
+                refresh: (refresh * 1000.).round() as i32,
+            };
+            if old_mode == mode {
+                continue;
+            }
+            // Keep only the current mode so repeated remote resizes do not grow state.
+            output.delete_mode(old_mode);
+            output.change_current_state(Some(mode), None, None, None);
+            output.set_preferred(mode);
+            niri.output_state.get_mut(output).unwrap().frame_clock = FrameClock::new(
+                Some(Duration::from_nanos(
+                    1_000_000_000_000 / mode.refresh as u64,
+                )),
+                false,
+            );
+            niri.output_resized(output);
+            let mut ipc_outputs = self.ipc_outputs.lock().unwrap();
+            let ipc_output = ipc_outputs.get_mut(output_id).unwrap();
+            ipc_output.modes = vec![niri_ipc::Mode {
+                width: requested.width,
+                height: requested.height,
+                refresh_rate: mode.refresh as u32,
+                is_preferred: true,
+            }];
+            ipc_output.current_mode = Some(0);
+            ipc_output.is_custom_mode = true;
+            ipc_output.logical = Some(logical_output(output));
+            niri.ipc_outputs_changed = true;
+        }
     }
 
