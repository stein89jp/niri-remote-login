+        ] {
+            let file = SealedFile::with_data(c"niri-rdp-keymap-test", bytes).unwrap();
+            assert!(read_keymap(file.as_fd().try_clone_to_owned().unwrap(), size).is_err());
+        }
+    }
+
+    #[test]
+    fn committed_unicode_and_delayed_forwarding_keep_their_maps_and_modifiers() {
+        let context = xkb::Context::new(xkb::CONTEXT_NO_FLAGS);
+        let canonical = xkb::Keymap::new_from_names(
+            &context,
+            "evdev",
+            "pc105",
+            "us,se",
+            "",
+            None,
+            xkb::KEYMAP_COMPILE_NO_FLAGS,
+        )
+        .unwrap();
+        let canonical_text = canonical.get_as_string(xkb::KEYMAP_FORMAT_TEXT_V1);
+        let canonical_file = KeymapFile::new(&canonical);
+        let shift = 1 << canonical.mod_get_index(xkb::MOD_NAME_SHIFT);
+        let caps = 1 << canonical.mod_get_index(xkb::MOD_NAME_CAPS);
+        let canonical_modifiers = [shift, 0, caps, 1];
+        let data = KeyboardData::default();
+        let mut client_state = None;
+        let mut last_keymap = String::new();
+        let mut text = String::new();
+        let mut events = Vec::new();
+        let mut decode = |event: DirectEvent<'_>| match event {
+            DirectEvent::Keymap(file) => {
+                events.push("keymap");
+                file.with_fd(true, |fd, size| {
+                    last_keymap =
+                        read_keymap(fd.try_clone_to_owned().unwrap(), size as u32).unwrap();
+                    let map = xkb::Keymap::new_from_string(
+                        &context,
+                        last_keymap.clone(),
+                        xkb::KEYMAP_FORMAT_TEXT_V1,
+                        xkb::KEYMAP_COMPILE_NO_FLAGS,
+                    )
+                    .unwrap();
+                    client_state = Some(xkb::State::new(&map));
+                })
+                .unwrap();
+            }
+            DirectEvent::Modifiers([depressed, latched, locked, group]) => {
+                events.push("modifiers");
+                client_state
+                    .as_mut()
+                    .unwrap()
+                    .update_mask(depressed, latched, locked, 0, 0, group);
+            }
+            DirectEvent::Key { key, state, .. } => {
+                events.push("key");
+                if state == 1 {
+                    text.push_str(
+                        &client_state
+                            .as_ref()
+                            .unwrap()
+                            .key_get_utf8((key + 8).into()),
+                    );
+                }
+            }
+        };
+        for character in "Phone@\"日本😀".chars() {
+            let map = format!(
+                "xkb_keymap {{ xkb_keycodes \"niri_rdp_unicode\" {{ minimum = 8; maximum = 255; <TEXT> = 255; }}; \
+                 xkb_types {{ type \"ONE_LEVEL\" {{ modifiers = None; level_name[Level1] = \"Any\"; }}; }}; \
+                 xkb_compatibility {{ }}; xkb_symbols {{ key <TEXT> {{ type = \"ONE_LEVEL\", [ 0x{:08x} ] }}; }}; }};",
+                0x01000000 | character as u32,
+            );
+            remember_keymap(&data, &map).unwrap();
+            assert!(*data.committed_text.lock().unwrap());
+            emit_direct_input(
+                &data,
+                &canonical_file,
+                canonical_modifiers,
+                Some((1, 247, 1)),
+                &mut decode,
+            );
+            emit_direct_input(
+                &data,
+                &canonical_file,
+                canonical_modifiers,
+                Some((2, 247, 0)),
+                &mut decode,
+            );
+        }
+        // A forwarded key carries its device's earlier layout/masks even after
+        // the compositor has restored another map or released physical Shift.
+        let forwarded = xkb::Keymap::new_from_names(
+            &context,
+            "evdev",
+            "pc105",
+            "se",
+            "",
+            None,
+            xkb::KEYMAP_COMPILE_NO_FLAGS,
+        )
+        .unwrap();
+        remember_keymap(&data, &forwarded.get_as_string(xkb::KEYMAP_FORMAT_TEXT_V1)).unwrap();
+        assert!(!*data.committed_text.lock().unwrap());
+        *data.submitted_modifiers.lock().unwrap() = [shift, 0, 0, 0];
+        emit_direct_input(
+            &data,
+            &canonical_file,
+            canonical_modifiers,
+            Some((3, 26, 1)),
+            &mut decode,
+        );
+        drop(decode);
+        assert_eq!(text, "Phone@\"日本😀Å");
+        assert_eq!(last_keymap, canonical_text);
+        let state = client_state.unwrap();
+        assert_eq!(state.serialize_mods(xkb::STATE_MODS_DEPRESSED), shift);
+        assert_eq!(state.serialize_mods(xkb::STATE_MODS_LOCKED), caps);
+        assert_eq!(state.serialize_layout(xkb::STATE_LAYOUT_EFFECTIVE), 1);
+        for event in events.chunks_exact(5) {
+            assert_eq!(event, ["keymap", "modifiers", "key", "keymap", "modifiers"]);
+        }
+    }
+}
