+//! Route virtual keyboard events through Niri's normal input handling.
+//!
+//! The pinned Smithay implementation writes directly to wl_keyboard, bypassing
+//! compositor bindings and grabs and swapping client keymaps independently of
+//! the compositor's XKB state. Keep one authoritative keymap and input path.
+use std::collections::BTreeSet;
+use std::fs::File;
+use std::io::{Read, Seek, SeekFrom};
+use std::sync::Mutex;
+
+use smithay::backend::input::KeyState;
+use smithay::input::keyboard::xkb;
+use smithay::input::keyboard::{Layout, ModifiersState};
+use smithay::reexports::wayland_protocols_misc::zwp_virtual_keyboard_v1::server::{
+    zwp_virtual_keyboard_manager_v1::{self, ZwpVirtualKeyboardManagerV1},
+    zwp_virtual_keyboard_v1::{self, ZwpVirtualKeyboardV1},
+};
+use smithay::reexports::wayland_server::{
+    backend::{ClientId, GlobalId},
+    Client, DataInit, Dispatch, DisplayHandle, GlobalDispatch, New, Resource,
+};
+
+use crate::niri::State;
+
+pub struct VirtualKeyboardManagerState {
+    _global: GlobalId,
+}
+
+pub struct ManagerData {
+    filter: Box<dyn Fn(&Client) -> bool + Send + Sync>,
+}
+
+#[derive(Default)]
+pub struct KeyboardData {
+    initialized: Mutex<bool>,
+    original_keymap: Mutex<Option<(String, ModifiersState)>>,
+    installed_keymap: Mutex<Option<String>>,
+    pressed: Mutex<BTreeSet<u32>>,
+}
+
+impl VirtualKeyboardManagerState {
+    pub fn new<F>(display: &DisplayHandle, filter: F) -> Self
+    where
+        F: Fn(&Client) -> bool + Send + Sync + 'static,
+    {
+        Self {
+            _global: display.create_global::<State, ZwpVirtualKeyboardManagerV1, _>(
+                1,
+                ManagerData {
+                    filter: Box::new(filter),
+                },
+            ),
+        }
+    }
+}
+
+impl GlobalDispatch<ZwpVirtualKeyboardManagerV1, ManagerData> for State {
+    fn bind(
+        _: &mut Self,
+        _: &DisplayHandle,
+        _: &Client,
+        resource: New<ZwpVirtualKeyboardManagerV1>,
+        _: &ManagerData,
+        data_init: &mut DataInit<'_, Self>,
+    ) {
+        data_init.init(resource, ());
+    }
+
+    fn can_view(client: Client, data: &ManagerData) -> bool {
+        (data.filter)(&client)
+    }
+}
+
+impl Dispatch<ZwpVirtualKeyboardManagerV1, ()> for State {
+    fn request(
+        state: &mut Self,
+        _: &Client,
+        _: &ZwpVirtualKeyboardManagerV1,
+        request: zwp_virtual_keyboard_manager_v1::Request,
+        _: &(),
+        _: &DisplayHandle,
+        data_init: &mut DataInit<'_, Self>,
+    ) {
+        if let zwp_virtual_keyboard_manager_v1::Request::CreateVirtualKeyboard { seat, id } =
+            request
+        {
+            // Niri has one seat. Do not accept a resource for a different seat.
+            if smithay::input::Seat::<State>::from_resource(&seat)
+                .is_some_and(|seat| seat == state.niri.seat)
+            {
+                data_init.init(id, KeyboardData::default());
+            } else {
+                data_init.post_error(id, 0u32, "unknown virtual keyboard seat");
+            }
+        }
+    }
+}
+
+impl Dispatch<ZwpVirtualKeyboardV1, KeyboardData> for State {
+    fn request(
+        state: &mut Self,
+        _: &Client,
+        resource: &ZwpVirtualKeyboardV1,
+        request: zwp_virtual_keyboard_v1::Request,
+        data: &KeyboardData,
+        _: &DisplayHandle,
+        _: &mut DataInit<'_, Self>,
+    ) {
+        let keyboard = state.niri.seat.get_keyboard().unwrap();
+        match request {
+            zwp_virtual_keyboard_v1::Request::Keymap { format, fd, size } => {
+                // Bound input before reading an untrusted fd. XKB text includes NUL.
+                if format != 1 || size == 0 || size > 1024 * 1024 {
+                    resource.post_error(0u32, "invalid virtual keyboard keymap");
+                    return;
+                }
+                let mut file = File::from(fd);
+                let mut bytes = Vec::new();
+                if file.seek(SeekFrom::Start(0)).is_err()
+                    || file.take(u64::from(size)).read_to_end(&mut bytes).is_err()
+                    || bytes.len() != size as usize
+                    || bytes.pop() != Some(0)
+                {
+                    resource.post_error(0u32, "invalid virtual keyboard keymap data");
+                    return;
+                }
+                let Ok(text) = String::from_utf8(bytes) else {
+                    resource.post_error(0u32, "virtual keyboard keymap is not UTF-8");
+                    return;
+                };
+                let original = keyboard.with_xkb_state(state, |context| {
+                    let current = context.xkb().lock().unwrap();
+                    // SAFETY: only an owned String leaves the locked XKB context.
+                    unsafe { current.keymap() }.get_as_string(xkb::KEYMAP_FORMAT_TEXT_V1)
+                });
+                // The bridge inherits this seat's map. An identical initial
+                // map must not reset its selected layout or lock state.
+                if text == original {
+                    *data.initialized.lock().unwrap() = true;
+                    return;
+                }
+                let original_modifiers = keyboard.modifier_state();
+                let restore = data
+                    .original_keymap
+                    .lock()
+                    .unwrap()
+                    .as_ref()
+                    .filter(|(saved, _)| saved == &text)
+                    .map(|(_, mods)| *mods);
+                if keyboard.set_keymap_from_string(state, text).is_err() {
+                    resource.post_error(0u32, "invalid XKB virtual keyboard keymap");
+                    return;
+                }
+                let installed = keyboard.with_xkb_state(state, |context| {
+                    let current = context.xkb().lock().unwrap();
+                    unsafe { current.keymap() }.get_as_string(xkb::KEYMAP_FORMAT_TEXT_V1)
+                });
+                if let Some(mods) = restore {
+                    keyboard.set_modifier_state(mods);
+                    keyboard.with_xkb_state(state, |mut context| {
+                        context.set_layout(Layout(mods.serialized.layout_effective));
+                    });
+                    data.original_keymap.lock().unwrap().take();
+                    data.installed_keymap.lock().unwrap().take();
+                } else {
+                    let mut saved = data.original_keymap.lock().unwrap();
+                    let mut last = data.installed_keymap.lock().unwrap();
+                    // A configuration reload supersedes an earlier baseline.
+                    if saved.is_none() || last.as_ref() != Some(&original) {
+                        *saved = Some((original, original_modifiers));
+                    }
+                    *last = Some(installed);
+                }
+                *data.initialized.lock().unwrap() = true;
+            }
+            zwp_virtual_keyboard_v1::Request::Key {
+                time,
+                key,
+                state: value,
+            } => {
+                if !*data.initialized.lock().unwrap() {
+                    resource.post_error(
+                        zwp_virtual_keyboard_v1::Error::NoKeymap,
+                        "key sent before keymap",
+                    );
+                    return;
+                }
+                if value > 1 || key > 0xfff7 {
+                    resource.post_error(0u32, "invalid virtual keyboard key");
+                    return;
+                }
+                if value == 1 {
+                    data.pressed.lock().unwrap().insert(key);
+                } else {
+                    data.pressed.lock().unwrap().remove(&key);
+                }
+                state.on_keyboard_key(
+                    (key + 8).into(),
+                    if value == 1 {
+                        KeyState::Pressed
+                    } else {
+                        KeyState::Released
+                    },
+                    time,
+                    &mut false,
+                );
+            }
+            zwp_virtual_keyboard_v1::Request::Modifiers {
+                mods_depressed,
+                mods_latched,
+                mods_locked,
+                group: _,
+            } => {
+                if !*data.initialized.lock().unwrap() {
+                    resource.post_error(
+                        zwp_virtual_keyboard_v1::Error::NoKeymap,
+                        "modifiers sent before keymap",
+                    );
+                    return;
+                }
+                // Interpret the wire masks with the same map as key events. Keep
+                // the XKB ref-counts local to the locked compositor context.
+                // The remote client's XKB state cannot observe a layout switch
+                // made by compositor bindings. Keep Niri's selected group.
+                let group = keyboard.modifier_state().serialized.layout_effective;
+                let mods = keyboard.with_xkb_state(state, |context| {
+                    let current = context.xkb().lock().unwrap();
+                    // SAFETY: the temporary state is dropped before current.
+                    let mut xkb_state = xkb::State::new(unsafe { current.keymap() });
+                    xkb_state.update_mask(mods_depressed, mods_latched, mods_locked, 0, 0, group);
+                    let mut mods = ModifiersState::default();
+                    mods.update_with(&xkb_state);
+                    mods
+                });
+                // update_mask and update_key must not reset one another after
+                // every letter. Ordinary keys already updated the seat state;
+                // apply a wire mask only when synchronization changes it.
+                if keyboard.modifier_state() != mods {
+                    keyboard.set_modifier_state(mods);
+                    if keyboard.modifier_state().serialized.layout_effective != group {
+                        keyboard
+                            .with_xkb_state(state, |mut context| context.set_layout(Layout(group)));
+                    }
+                    keyboard.advertise_modifier_state(state);
+                }
+            }
+            zwp_virtual_keyboard_v1::Request::Destroy => {}
+            _ => {}
+        }
+    }
+
+    fn destroyed(state: &mut Self, _: ClientId, _: &ZwpVirtualKeyboardV1, data: &KeyboardData) {
+        // Disconnects must not leave Ctrl, Shift or Meta held for the next client.
+        for key in std::mem::take(&mut *data.pressed.lock().unwrap()) {
+            state.on_keyboard_key((key + 8).into(), KeyState::Released, 0, &mut false);
+        }
+        if let Some((original, mods)) = data.original_keymap.lock().unwrap().take() {
+            let keyboard = state.niri.seat.get_keyboard().unwrap();
+            let current = keyboard.with_xkb_state(state, |context| {
+                let xkb = context.xkb().lock().unwrap();
+                unsafe { xkb.keymap() }.get_as_string(xkb::KEYMAP_FORMAT_TEXT_V1)
+            });
+            // A later configuration reload belongs to the desktop. Only undo
+            // a map which this virtual device still owns (e.g. interrupted text).
+            if data.installed_keymap.lock().unwrap().as_ref() != Some(&current) {
+                return;
+            }
+            if let Err(err) = keyboard.set_keymap_from_string(state, original) {
+                warn!("could not restore seat keymap after remote keyboard disconnect: {err:?}");
+            } else {
+                keyboard.set_modifier_state(mods);
+                keyboard.with_xkb_state(state, |mut context| {
+                    context.set_layout(Layout(mods.serialized.layout_effective));
+                });
+            }
+        }
+    }
+}
