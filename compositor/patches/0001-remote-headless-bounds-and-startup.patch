@@ -0,0 +1,892 @@
+//! Route virtual keyboard events through Niri's normal input handling.
+//!
+//! The pinned Smithay implementation writes directly to wl_keyboard, bypassing
+//! compositor bindings and grabs and swapping client keymaps independently of
+//! the compositor's XKB state. Keep one authoritative keymap and input path.
+use std::collections::BTreeSet;
+use std::fs::File;
+use std::io::{Read, Seek, SeekFrom};
+use std::os::fd::OwnedFd;
+use std::sync::Mutex;
+
+use smithay::backend::input::KeyState;
+use smithay::input::keyboard::xkb;
+use smithay::input::keyboard::{KeymapFile, Layout, ModifiersState};
+use smithay::reexports::wayland_protocols_misc::zwp_virtual_keyboard_v1::server::{
+    zwp_virtual_keyboard_manager_v1::{self, ZwpVirtualKeyboardManagerV1},
+    zwp_virtual_keyboard_v1::{self, ZwpVirtualKeyboardV1},
+};
+use smithay::reexports::wayland_server::{
+    backend::{ClientId, GlobalId},
+    Client, DataInit, Dispatch, DisplayHandle, GlobalDispatch, New, Resource,
+};
+use smithay::utils::SERIAL_COUNTER;
+use smithay::wayland::seat::WaylandFocus;
+
+use super::input_method;
+use crate::niri::State;
+
+fn read_keymap(fd: OwnedFd, size: u32) -> Result<String, &'static str> {
+    if size == 0 || size > 1024 * 1024 {
+        return Err("invalid virtual keyboard keymap size");
+    }
+    let mut file = File::from(fd);
+    let mut bytes = Vec::new();
+    if file.seek(SeekFrom::Start(0)).is_err()
+        || file.take(u64::from(size)).read_to_end(&mut bytes).is_err()
+        || bytes.len() != size as usize
+    {
+        return Err("invalid virtual keyboard keymap data");
+    }
+    // Smithay's unsealed input-method grab fd omits the final NUL. Fcitx
+    // relays that exact fd and size; bridge keymaps include the terminator.
+    if bytes.last() == Some(&0) {
+        bytes.pop();
+    }
+    if bytes.contains(&0) {
+        return Err("virtual keyboard keymap contains an embedded NUL");
+    }
+    if bytes.is_empty() {
+        return Err("empty virtual keyboard keymap");
+    }
+    String::from_utf8(bytes).map_err(|_| "virtual keyboard keymap is not UTF-8")
+}
+
+pub struct VirtualKeyboardManagerState {
+    _global: GlobalId,
+}
+
+pub struct ManagerData {
+    filter: Box<dyn Fn(&Client) -> bool + Send + Sync>,
+}
+
+#[derive(Default)]
+pub struct KeyboardData {
+    initialized: Mutex<bool>,
+    original_keymap: Mutex<Option<(String, ModifiersState)>>,
+    installed_keymap: Mutex<Option<String>>,
+    pressed: Mutex<BTreeSet<u32>>,
+    submitted_keymap: Mutex<Option<KeymapFile>>,
+    submitted_text: Mutex<String>,
+    submitted_modifiers: Mutex<[u32; 4]>,
+    committed_text: Mutex<bool>,
+    text_device: Mutex<bool>,
+    direct_pressed: Mutex<BTreeSet<u32>>,
+}
+
+fn remember_keymap(data: &KeyboardData, text: &str) -> Result<(), &'static str> {
+    let context = xkb::Context::new(xkb::CONTEXT_NO_FLAGS);
+    let keymap = xkb::Keymap::new_from_string(
+        &context,
+        text.to_owned(),
+        xkb::KEYMAP_FORMAT_TEXT_V1,
+        xkb::KEYMAP_COMPILE_NO_FLAGS,
+    )
+    .ok_or("invalid XKB virtual keyboard keymap")?;
+    // Keep the dedicated Unicode device separate from the canonical seat map.
+    *data.committed_text.lock().unwrap() = text.contains("xkb_keycodes \"niri_rdp_unicode\"");
+    if *data.committed_text.lock().unwrap() {
+        *data.text_device.lock().unwrap() = true;
+    }
+    *data.submitted_text.lock().unwrap() = keymap.get_as_string(xkb::KEYMAP_FORMAT_TEXT_V1);
+    *data.submitted_keymap.lock().unwrap() = Some(KeymapFile::new(&keymap));
+    *data.submitted_modifiers.lock().unwrap() = [0; 4];
+    Ok(())
+}
+
+enum DirectEvent<'a> {
+    Keymap(&'a KeymapFile),
+    Modifiers([u32; 4]),
+    Key { time: u32, key: u32, state: u32 },
+}
+
+fn emit_direct_input(
+    data: &KeyboardData,
+    canonical: &KeymapFile,
+    canonical_modifiers: [u32; 4],
+    key: Option<(u32, u32, u32)>,
+    mut emit: impl FnMut(DirectEvent<'_>),
+) {
+    let submitted = data.submitted_keymap.lock().unwrap();
+    let Some(submitted) = submitted.as_ref() else {
+        return;
+    };
+    // The seat may have advanced while an input method processed an earlier
+    // key. Interpret the returned event with that virtual device's own map/masks.
+    emit(DirectEvent::Keymap(submitted));
+    emit(DirectEvent::Modifiers(
+        *data.submitted_modifiers.lock().unwrap(),
+    ));
+    if let Some((time, key, state)) = key {
+        emit(DirectEvent::Key { time, key, state });
+    }
+    // Keep the client's next physical event and focus enter in the seat's map.
+    emit(DirectEvent::Keymap(canonical));
+    emit(DirectEvent::Modifiers(canonical_modifiers));
+}
+
+fn direct_input(state: &mut State, data: &KeyboardData, key: Option<(u32, u32, u32)>) {
+    let keyboard = state.niri.seat.get_keyboard().unwrap();
+    let Some(focus) = keyboard
+        .current_focus()
+        .and_then(|focus| focus.wl_surface().and_then(|surface| surface.client()))
+    else {
+        return;
+    };
+    let canonical = keyboard.with_xkb_state(state, |context| {
+        let current = context.xkb().lock().unwrap();
+        // SAFETY: KeymapFile owns bytes and retains no XKB ref-counts.
+        KeymapFile::new(unsafe { current.keymap() })
+    });
+    let mods = keyboard.modifier_state().serialized;
+    let modifiers = [
+        mods.depressed,
+        mods.latched,
+        mods.locked,
+        mods.layout_effective,
+    ];
+    for target in keyboard.client_keyboards(&focus) {
+        emit_direct_input(data, &canonical, modifiers, key, |event| match event {
+            DirectEvent::Keymap(map) => {
+                if let Err(error) = map.send(&target) {
+                    warn!("could not send virtual keyboard keymap: {error}");
+                }
+            }
+            DirectEvent::Modifiers([depressed, latched, locked, group]) => {
+                target.modifiers(
+                    SERIAL_COUNTER.next_serial().into(),
+                    depressed,
+                    latched,
+                    locked,
+                    group,
+                );
+            }
+            DirectEvent::Key { time, key, state } => {
+                target.key(SERIAL_COUNTER.next_serial().into(), time, key, if state == 1 {
+                        smithay::reexports::wayland_server::protocol::wl_keyboard::KeyState::Pressed
+                    } else {
+                        smithay::reexports::wayland_server::protocol::wl_keyboard::KeyState::Released
+                    });
+            }
+        });
+    }
+}
+
+pub(super) fn direct_key(state: &mut State, data: &KeyboardData, time: u32, key: u32, value: u32) {
+    if value == 1 {
+        data.direct_pressed.lock().unwrap().insert(key);
+    } else {
+        data.direct_pressed.lock().unwrap().remove(&key);
+    }
+    direct_input(state, data, Some((time, key, value)));
+}
+
+fn committed_key(state: &mut State, data: &KeyboardData, time: u32, key: u32, value: KeyState) {
+    if sync_submitted_keymap(state, data) {
+        // Share the grab's FIFO with earlier and later physical events.
+        let keyboard = state.niri.seat.get_keyboard().unwrap();
+        keyboard.input_forward(
+            state,
+            (key + 8).into(),
+            value,
+            SERIAL_COUNTER.next_serial(),
+            time,
+            false,
+        );
+    } else {
+        direct_key(
+            state,
+            data,
+            time,
+            key,
+            if value == KeyState::Pressed { 1 } else { 0 },
+        );
+    }
+}
+
+fn sync_submitted_keymap(state: &State, data: &KeyboardData) -> bool {
+    let submitted = data.submitted_keymap.lock().unwrap();
+    let Some(file) = submitted.as_ref() else {
+        return false;
+    };
+    input_method::sync_keymap(
+        state,
+        &data.submitted_text.lock().unwrap(),
+        file,
+        *data.submitted_modifiers.lock().unwrap(),
+    )
+}
+
+impl VirtualKeyboardManagerState {
+    pub fn new<F>(display: &DisplayHandle, filter: F) -> Self
+    where
+        F: Fn(&Client) -> bool + Send + Sync + 'static,
+    {
+        Self {
+            _global: display.create_global::<State, ZwpVirtualKeyboardManagerV1, _>(
+                1,
+                ManagerData {
+                    filter: Box::new(filter),
+                },
+            ),
+        }
+    }
+}
+
+impl GlobalDispatch<ZwpVirtualKeyboardManagerV1, ManagerData> for State {
+    fn bind(
+        _: &mut Self,
+        _: &DisplayHandle,
+        _: &Client,
+        resource: New<ZwpVirtualKeyboardManagerV1>,
+        _: &ManagerData,
+        data_init: &mut DataInit<'_, Self>,
+    ) {
+        data_init.init(resource, ());
+    }
+
+    fn can_view(client: Client, data: &ManagerData) -> bool {
+        (data.filter)(&client)
+    }
+}
+
+impl Dispatch<ZwpVirtualKeyboardManagerV1, ()> for State {
+    fn request(
+        state: &mut Self,
+        _: &Client,
+        _: &ZwpVirtualKeyboardManagerV1,
+        request: zwp_virtual_keyboard_manager_v1::Request,
+        _: &(),
+        _: &DisplayHandle,
+        data_init: &mut DataInit<'_, Self>,
+    ) {
+        if let zwp_virtual_keyboard_manager_v1::Request::CreateVirtualKeyboard { seat, id } =
+            request
+        {
+            // Niri has one seat. Do not accept a resource for a different seat.
+            if smithay::input::Seat::<State>::from_resource(&seat)
+                .is_some_and(|seat| seat == state.niri.seat)
+            {
+                data_init.init(id, KeyboardData::default());
+            } else {
+                data_init.post_error(id, 0u32, "unknown virtual keyboard seat");
+            }
+        }
+    }
+}
+
+impl Dispatch<ZwpVirtualKeyboardV1, KeyboardData> for State {
+    fn request(
+        state: &mut Self,
+        client: &Client,
+        resource: &ZwpVirtualKeyboardV1,
+        request: zwp_virtual_keyboard_v1::Request,
+        data: &KeyboardData,
+        _: &DisplayHandle,
+        _: &mut DataInit<'_, Self>,
+    ) {
+        let keyboard = state.niri.seat.get_keyboard().unwrap();
+        match request {
+            zwp_virtual_keyboard_v1::Request::Keymap { format, fd, size } => {
+                if format != 1 {
+                    resource.post_error(0u32, "invalid virtual keyboard keymap");
+                    return;
+                }
+                let text = match read_keymap(fd, size) {
+                    Ok(text) => text,
+                    Err(error) => {
+                        resource.post_error(0u32, error);
+                        return;
+                    }
+                };
+                if let Err(error) = remember_keymap(data, &text) {
+                    resource.post_error(0u32, error);
+                    return;
+                }
+                if input_method::owns_keyboard_grab(state, &client.id()) {
+                    *data.initialized.lock().unwrap() = true;
+                    return;
+                }
+                if *data.text_device.lock().unwrap() {
+                    if *data.committed_text.lock().unwrap() {
+                        sync_submitted_keymap(state, data);
+                    } else {
+                        input_method::sync_canonical_keymap(state);
+                    }
+                    *data.initialized.lock().unwrap() = true;
+                    return;
+                }
+                let original = keyboard.with_xkb_state(state, |context| {
+                    let current = context.xkb().lock().unwrap();
+                    // SAFETY: only an owned String leaves the locked XKB context.
+                    unsafe { current.keymap() }.get_as_string(xkb::KEYMAP_FORMAT_TEXT_V1)
+                });
+                // The bridge inherits this seat's map. An identical initial
+                // map must not reset its selected layout or lock state.
+                if text == original {
+                    *data.initialized.lock().unwrap() = true;
+                    input_method::sync_canonical_keymap(state);
+                    return;
+                }
+                let original_modifiers = keyboard.modifier_state();
+                let restore = data
+                    .original_keymap
+                    .lock()
+                    .unwrap()
+                    .as_ref()
+                    .filter(|(saved, _)| saved == &text)
+                    .map(|(_, mods)| *mods);
+                if keyboard.set_keymap_from_string(state, text).is_err() {
+                    resource.post_error(0u32, "invalid XKB virtual keyboard keymap");
+                    return;
+                }
+                let installed = keyboard.with_xkb_state(state, |context| {
+                    let current = context.xkb().lock().unwrap();
+                    unsafe { current.keymap() }.get_as_string(xkb::KEYMAP_FORMAT_TEXT_V1)
+                });
+                if let Some(mods) = restore {
+                    keyboard.set_modifier_state(mods);
+                    keyboard.with_xkb_state(state, |mut context| {
+                        context.set_layout(Layout(mods.serialized.layout_effective));
+                    });
+                    data.original_keymap.lock().unwrap().take();
+                    data.installed_keymap.lock().unwrap().take();
+                } else {
+                    let mut saved = data.original_keymap.lock().unwrap();
+                    let mut last = data.installed_keymap.lock().unwrap();
+                    // A configuration reload supersedes an earlier baseline.
+                    if saved.is_none() || last.as_ref() != Some(&original) {
+                        *saved = Some((original, original_modifiers));
+                    }
+                    *last = Some(installed);
+                }
+                *data.initialized.lock().unwrap() = true;
+                input_method::sync_canonical_keymap(state);
+            }
+            zwp_virtual_keyboard_v1::Request::Key {
+                time,
+                key,
+                state: value,
+            } => {
+                if !*data.initialized.lock().unwrap() {
+                    resource.post_error(
+                        zwp_virtual_keyboard_v1::Error::NoKeymap,
+                        "key sent before keymap",
+                    );
+                    return;
+                }
+                if value > 1 || key > 0xfff7 {
+                    resource.post_error(0u32, "invalid virtual keyboard key");
+                    return;
+                }
+                let value = if value == 1 {
+                    KeyState::Pressed
+                } else {
+                    KeyState::Released
+                };
+                if input_method::forward_key(
+                    state,
+                    &client.id(),
+                    data,
+                    (key + 8).into(),
+                    value,
+                    time,
+                ) {
+                    return;
+                }
+                if *data.committed_text.lock().unwrap() {
+                    committed_key(state, data, time, key, value);
+                    return;
+                }
+                if value == KeyState::Pressed {
+                    data.pressed.lock().unwrap().insert(key);
+                } else {
+                    data.pressed.lock().unwrap().remove(&key);
+                }
+                input_method::sync_canonical_keymap(state);
+                state.on_keyboard_key((key + 8).into(), value, time, &mut false);
+            }
+            zwp_virtual_keyboard_v1::Request::Modifiers {
+                mods_depressed,
+                mods_latched,
+                mods_locked,
+                group: submitted_group,
+            } => {
+                if !*data.initialized.lock().unwrap() {
+                    resource.post_error(
+                        zwp_virtual_keyboard_v1::Error::NoKeymap,
+                        "modifiers sent before keymap",
+                    );
+                    return;
+                }
+                *data.submitted_modifiers.lock().unwrap() =
+                    [mods_depressed, mods_latched, mods_locked, submitted_group];
+                if input_method::owns_keyboard_grab(state, &client.id()) {
+                    direct_input(state, data, None);
+                    return;
+                }
+                if *data.committed_text.lock().unwrap() {
+                    if !sync_submitted_keymap(state, data) {
+                        direct_input(state, data, None);
+                    }
+                    return;
+                }
+                // Interpret the wire masks with the same map as key events. Keep
+                // the XKB ref-counts local to the locked compositor context.
+                // The remote client's XKB state cannot observe a layout switch
+                // made by compositor bindings. Keep Niri's selected group.
+                let group = keyboard.modifier_state().serialized.layout_effective;
+                let mods = keyboard.with_xkb_state(state, |context| {
+                    let current = context.xkb().lock().unwrap();
+                    // SAFETY: the temporary state is dropped before current.
+                    let mut xkb_state = xkb::State::new(unsafe { current.keymap() });
+                    xkb_state.update_mask(mods_depressed, mods_latched, mods_locked, 0, 0, group);
+                    let mut mods = ModifiersState::default();
+                    mods.update_with(&xkb_state);
+                    mods
+                });
+                // update_mask and update_key must not reset one another after
+                // every letter. Ordinary keys already updated the seat state;
+                // apply a wire mask only when synchronization changes it.
+                if keyboard.modifier_state() != mods {
+                    keyboard.set_modifier_state(mods);
+                    if keyboard.modifier_state().serialized.layout_effective != group {
+                        keyboard
+                            .with_xkb_state(state, |mut context| context.set_layout(Layout(group)));
+                    }
+                    keyboard.advertise_modifier_state(state);
+                }
+                input_method::sync_canonical_keymap(state);
+            }
+            zwp_virtual_keyboard_v1::Request::Destroy => {}
+            _ => {}
+        }
+    }
+
+    fn destroyed(state: &mut Self, _: ClientId, _: &ZwpVirtualKeyboardV1, data: &KeyboardData) {
+        // A disconnect between an input method's press/release must not leave
+        // the focused application with a held key, or alter physical seat state.
+        for key in std::mem::take(&mut *data.direct_pressed.lock().unwrap()) {
+            direct_input(state, data, Some((0, key, 0)));
+        }
+        // Disconnects must not leave Ctrl, Shift or Meta held for the next client.
+        for key in std::mem::take(&mut *data.pressed.lock().unwrap()) {
+            state.on_keyboard_key((key + 8).into(), KeyState::Released, 0, &mut false);
+        }
+        if let Some((original, mods)) = data.original_keymap.lock().unwrap().take() {
+            let keyboard = state.niri.seat.get_keyboard().unwrap();
+            let current = keyboard.with_xkb_state(state, |context| {
+                let xkb = context.xkb().lock().unwrap();
+                unsafe { xkb.keymap() }.get_as_string(xkb::KEYMAP_FORMAT_TEXT_V1)
+            });
+            // A later configuration reload belongs to the desktop. Only undo
+            // a map which this virtual device still owns (e.g. interrupted text).
+            if data.installed_keymap.lock().unwrap().as_ref() != Some(&current) {
+                return;
+            }
+            if let Err(err) = keyboard.set_keymap_from_string(state, original) {
+                warn!("could not restore seat keymap after remote keyboard disconnect: {err:?}");
+            } else {
+                keyboard.set_modifier_state(mods);
+                keyboard.with_xkb_state(state, |mut context| {
+                    context.set_layout(Layout(mods.serialized.layout_effective));
+                });
+            }
+        }
+    }
+}
