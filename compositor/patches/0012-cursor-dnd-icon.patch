+/// Drag-and-drop icon relative to the pointer, where `render_pointer()` draws it.
+///
+/// Includes the pointer pixel, so that the hotspot stays inside the capture even when the icon
+/// is away from the pointer and the cursor is hidden.
+pub fn dnd_icon_capture_rect(niri: &Niri, output: &Output) -> Option<Rectangle<i32, Physical>> {
+    let icon = niri.dnd_icon.as_ref()?;
+    let scale = Scale::from(output.current_scale().fractional_scale());
+    let bbox = smithay::desktop::utils::bbox_from_surface_tree(&icon.surface, icon.offset);
+    let rect = bbox.to_f64().to_physical_precise_up(scale);
+    (!rect.is_empty()).then(|| rect.merge(Rectangle::from_size(Size::from((1, 1)))))
+}
+
+/// Area of the cursor capture relative to the pointer: the cursor image and, during a drag, the
+/// drag-and-drop icon, like `render_pointer()` draws them. `None` when both are hidden.
+pub fn cursor_capture_area(niri: &Niri, output: &Output) -> Option<Rectangle<i32, Physical>> {
+    let size = cursor_image_size(niri, output);
+    let cursor = (!size.is_empty()).then(|| {
+        let hotspot = cursor_image_hotspot(niri, output);
+        Rectangle::new(Point::from((-hotspot.x, -hotspot.y)), size)
+    });
+    match (cursor, dnd_icon_capture_rect(niri, output)) {
+        (Some(cursor), Some(icon)) => Some(cursor.merge(icon)),
+        (cursor, icon) => cursor.or(icon),
+    }
+}
+
+/// Size of the cursor capture buffer on this output.
+fn cursor_capture_size(niri: &Niri, output: &Output) -> Size<i32, BufferCoords> {
+    match cursor_capture_area(niri, output) {
+        Some(area) => Size::from((area.size.w, area.size.h)),
+        // Fall back to the nominal cursor size when the cursor is currently hidden or has no
+        // buffer, so that the session always has valid constraints.
+        None => {
+            let int_scale = output.current_scale().integer_scale();
+            let fallback = i32::from(niri.config.borrow().cursor.xcursor_size) * int_scale;
+            Size::from((fallback, fallback))
+        }
+    }
+}
+
+/// Cursor hotspot (the pointer position) in capture buffer coordinates.
+pub fn cursor_capture_hotspot(niri: &Niri, output: &Output) -> Point<i32, BufferCoords> {
+    cursor_capture_area(niri, output).map_or(Point::from((0, 0)), |area| {
+        Point::from((-area.loc.x, -area.loc.y))
+    })
 }
 
