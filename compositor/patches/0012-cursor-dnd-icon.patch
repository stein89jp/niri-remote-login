+/// Capture buffer size and hotspot, updated from new events (unchanged values are not resent).
+fn geometry(capture: &Capture, last: &mut ((i32, i32), (i32, i32))) -> ((i32, i32), (i32, i32)) {
+    for event in capture.take_raw() {
+        let mut words = event.split(' ');
+        let kind = words.next().unwrap();
+        let mut numbers = words.map(|n| n.parse().unwrap());
+        let mut pair = || (numbers.next().unwrap(), numbers.next().unwrap());
+        match kind {
+            "buffer_size" => last.0 = pair(),
+            "hotspot" => last.1 = pair(),
+            _ => (),
+        }
+    }
+    *last
+}
+
+/// Uses a mapped 100x50 window surface as the drag-and-drop icon, as smithay's DnD grab would set
+/// `Niri::dnd_icon` for `wl_data_device.start_drag`.
+fn start_drag(f: &mut Fixture, id: ClientId, offset: (i32, i32)) {
+    let window = f.client(id).create_window();
+    let surface = window.surface.clone();
+    window.commit();
+    f.roundtrip(id);
+    let window = f.client(id).window(&surface);
+    window.attach_new_buffer();
+    window.set_size(100, 50);
+    window.ack_last_and_commit();
+    f.double_roundtrip(id);
+
+    let niri = f.niri();
+    let mapped = niri.layout.windows().next().unwrap().1;
+    let surface = mapped.toplevel().wl_surface().clone();
+    niri.dnd_icon = Some(DndIcon {
+        surface,
+        offset: Point::from(offset),
+    });
+}
+
+#[test]
+fn drag_icon_extends_the_cursor_capture_like_the_pointer_render() {
+    let mut f = set_up();
+    let bridge = add_client(&mut f);
+    warp(&mut f, bridge, 500., 500.);
+    let capture = cursor_session(&mut f, bridge);
+    let mut last = Default::default();
+    let ((w, h), (hot_x, hot_y)) = geometry(&capture, &mut last);
+    assert!(w > 0 && h > 0);
+
+    // The icon is drawn at its offset from the pointer, so the capture grows to the union of the
+    // cursor image (at -hotspot) and the icon, and the hotspot moves with the new origin.
+    start_drag(&mut f, bridge, (10, 20));
+    f.double_roundtrip(bridge);
+    let left = (-hot_x).min(10);
+    let top = (-hot_y).min(20);
+    let right = (w - hot_x).max(110);
+    let bottom = (h - hot_y).max(70);
+    assert_eq!(
+        geometry(&capture, &mut last),
+        ((right - left, bottom - top), (-left, -top))
+    );
+
+    // An icon above and to the left of the pointer moves the hotspot accordingly.
+    f.niri().dnd_icon.as_mut().unwrap().offset = Point::from((-120, -60));
+    f.double_roundtrip(bridge);
+    let left = (-hot_x).min(-120);
+    let top = (-hot_y).min(-60);
+    let right = (w - hot_x).max(1);
+    let bottom = (h - hot_y).max(1);
+    assert_eq!(
+        geometry(&capture, &mut last),
+        ((right - left, bottom - top), (-left, -top))
+    );
+
+    // Dropping restores the cursor-only capture.
+    f.niri().dnd_icon = None;
+    f.double_roundtrip(bridge);
+    assert_eq!(geometry(&capture, &mut last), ((w, h), (hot_x, hot_y)));
+}
+
+#[test]
+fn drag_icon_keeps_the_hotspot_inside_a_capture_without_cursor() {
+    let mut f = set_up();
+    let bridge = add_client(&mut f);
+    warp(&mut f, bridge, 500., 500.);
+    let capture = cursor_session(&mut f, bridge);
+    let mut last = Default::default();
+    geometry(&capture, &mut last);
+
+    f.niri()
+        .cursor_manager
+        .set_cursor_image(CursorImageStatus::Hidden);
+    start_drag(&mut f, bridge, (30, 40));
+    f.double_roundtrip(bridge);
+    // The capture spans the pointer pixel and the icon.
+    assert_eq!(geometry(&capture, &mut last), ((130, 90), (0, 0)));
+}
