-        // Use a timer to pace redraws, simulating vblank for headless outputs.
+        // Simulate a fixed-phase vblank: present at the next refresh boundary instead of a full
+        // interval after this render, so render time does not stretch the period.
         let refresh_interval = output_state
             .frame_clock
             .refresh_interval()
             .unwrap_or(Duration::from_micros(16_667));
+        let mut presentation_time = output_state.frame_clock.next_presentation_time();
+        if presentation_time <= now {
+            presentation_time = now + refresh_interval;
+        }
 
+        // Update the frame clock so animation timing works correctly.
+        output_state.frame_clock.presented(presentation_time);
+        output_state.frame_callback_sequence = output_state.frame_callback_sequence.wrapping_add(1);
+
+        // Like a DRM page flip, hold further redraws until the simulated vblank. Redrawing
+        // earlier would restart this timer on every input event and starve frame callbacks.
         let output_clone = output.clone();
-        let timer = Timer::from_duration(refresh_interval);
-        let token = niri
-            .event_loop
+        let timer = Timer::from_duration(presentation_time - now);
+        niri.event_loop
             .insert_source(timer, move |_, _, data| {
-                let output_state = data.niri.output_state.get_mut(&output_clone).unwrap();
+                // The output may have been removed while the timer was pending.
+                let Some(output_state) = data.niri.output_state.get_mut(&output_clone) else {
+                    return TimeoutAction::Drop;
+                };
+                let redraw_needed = match output_state.redraw_state {
+                    RedrawState::WaitingForVBlank { redraw_needed } => redraw_needed,
+                    _ => return TimeoutAction::Drop,
+                };
+                output_state.redraw_state = RedrawState::Idle;
                 output_state.frame_callback_sequence =
                     output_state.frame_callback_sequence.wrapping_add(1);
+                let redraw = redraw_needed || output_state.unfinished_animations_remain;
 
-                match mem::replace(&mut output_state.redraw_state, RedrawState::Idle) {
-                    RedrawState::WaitingForEstimatedVBlank(_) => (),
-                    RedrawState::WaitingForEstimatedVBlankAndQueued(_) => {
-                        output_state.redraw_state = RedrawState::Queued;
-                        return TimeoutAction::Drop;
-                    }
-                    _ => unreachable!(),
-                }
-
-                if output_state.unfinished_animations_remain {
+                // Headless rendering does not track primary scanout outputs, so the redraw path's
+                // send_frame_callbacks() skips these surfaces. Answer them on every vblank.
+                data.niri
+                    .send_frame_callbacks_for_virtual_output(&output_clone);
+                if redraw {
                     data.niri.queue_redraw(&output_clone);
-                } else {
-                    data.niri
-                        .send_frame_callbacks_for_virtual_output(&output_clone);
                 }
                 TimeoutAction::Drop
             })
             .unwrap();
-        output_state.redraw_state = RedrawState::WaitingForEstimatedVBlank(token);
+        output_state.redraw_state = RedrawState::WaitingForVBlank {
+            redraw_needed: false,
+        };
 
         RenderResult::Submitted
     }
