+const REFRESH: Duration = Duration::from_micros(16_667);
+
+/// Gives the test output the 60 Hz frame clock of HEADLESS-1 and waits until it is idle.
+fn virtual_60hz(f: &mut Fixture) -> Output {
+    let output = f.niri_output(1);
+    f.niri_complete_animations();
+    f.niri().output_state.get_mut(&output).unwrap().frame_clock =
+        FrameClock::new(Some(REFRESH), false);
+    let deadline = Instant::now() + Duration::from_secs(1);
+    while !matches!(
+        f.niri().output_state[&output].redraw_state,
+        RedrawState::Idle
+    ) {
+        assert!(Instant::now() < deadline, "output never became idle");
+        sleep(Duration::from_millis(1));
+        f.state.server.dispatch();
+    }
+    output
+}
+
+fn last_presentation(f: &mut Fixture, output: &Output) -> Duration {
+    let state = &f.niri().output_state[output];
+    state.frame_clock.last_presentation_time().unwrap()
+}
+
+#[test]
+fn headless_redraws_wait_for_a_fixed_phase_vblank() {
+    let (mut f, _id, _surface) = set_up();
+    let output = virtual_60hz(&mut f);
+
+    f.niri().queue_redraw(&output);
+    f.state.server.dispatch();
+    let first = last_presentation(&mut f, &output);
+
+    // Remote pointer motion before the simulated vblank must not render again and restart it.
+    f.niri().queue_redraw(&output);
+    f.state.server.dispatch();
+    if get_monotonic_time() < first {
+        assert!(matches!(
+            f.niri().output_state[&output].redraw_state,
+            RedrawState::WaitingForVBlank {
+                redraw_needed: true
+            }
+        ));
+        assert_eq!(last_presentation(&mut f, &output), first);
+    }
+
+    // A redraw that finishes after the vblank keeps the refresh phase instead of drifting by
+    // its render time.
+    let deadline = Instant::now() + Duration::from_secs(1);
+    while last_presentation(&mut f, &output) == first {
+        assert!(Instant::now() < deadline, "queued redraw never ran");
+        sleep(Duration::from_millis(5));
+        f.state.server.dispatch();
+    }
+    let elapsed = last_presentation(&mut f, &output) - first;
+    assert_eq!(elapsed.as_nanos() % REFRESH.as_nanos(), 0, "{elapsed:?}");
+}
+
+#[test]
+fn headless_frame_callbacks_continue_during_continuous_redraws() {
+    let (mut f, id, surface) = set_up();
+    let output = virtual_60hz(&mut f);
+
+    let window = f.client(id).window(&surface);
+    let frame = Arc::new(SyncData::default());
+    window.surface.frame(&window.qh, frame.clone());
+    window.commit();
+    f.roundtrip(id);
+
+    // Remote pointer motion queues redraws faster than the refresh rate.
+    let deadline = Instant::now() + Duration::from_millis(100);
+    while !frame.done.load(Ordering::Relaxed) {
+        assert!(
+            Instant::now() < deadline,
+            "no frame callback during continuous redraws"
+        );
+        f.niri().queue_redraw(&output);
+        f.state.server.dispatch();
+        f.client(id).dispatch();
+        sleep(Duration::from_millis(1));
+    }
+}
