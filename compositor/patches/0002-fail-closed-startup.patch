-                    warn!("failed to initialize headless renderer: {err:?}");
-                }
+                headless
+                    .add_renderer()
+                    .context("failed to initialize headless renderer")?;
                 headless
                     .create_virtual_output(&mut state.niri, 1920, 1080, 60)
-                    .unwrap();
+                    .map_err(anyhow::Error::msg)
+                    .context("failed to create default headless output")?;
             }
         }
 
@@ -2700,7 +2701,14 @@ impl Niri {
             .unwrap();
 
         let socket_name = create_wayland_socket.then(|| {
-            let socket_source = ListeningSocketSource::new_auto().unwrap();
+            // A remote headless session has a broker-owned private runtime directory.
+            // Bind a deterministic socket there; never discover a local desktop socket.
+            let socket_source = if matches!(backend, Backend::Headless(_)) {
+                ListeningSocketSource::with_name("wayland-0")
+            } else {
+                ListeningSocketSource::new_auto()
+            }
+            .expect("failed to bind Wayland socket");
             let socket_name = socket_source.socket_name().to_os_string();
             event_loop
                 .insert_source(socket_source, move |client, _, state| {
