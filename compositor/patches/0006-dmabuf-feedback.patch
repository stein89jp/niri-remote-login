 use crate::render_helpers::{resources, shaders};
 use crate::utils::{get_monotonic_time, logical_output};
 
@@ -127,6 +128,45 @@ impl Headless {
         unsafe { GlesRenderer::new(context) }.context("error creating renderer")
     }
 
+    /// Advertise zwp_linux_dmabuf_v1 for a hardware renderer, with default feedback for its
+    /// render node. Returns whether the global was created.
+    pub fn create_dmabuf_global(&mut self, niri: &mut Niri) -> bool {
+        let Some(renderer) = self.renderer.as_ref() else {
+            return false;
+        };
+        let display = renderer.egl_context().display();
+        let Ok(device) = EGLDevice::device_for_display(display) else {
+            return false;
+        };
+        if device.is_software() {
+            return false;
+        }
+        // Allow accelerated applications to submit GPU buffers rather than
+        // downloading every window to SHM before the compositor uploads it again.
+        let formats = renderer.dmabuf_formats();
+        if formats.iter().next().is_none() {
+            return false;
+        }
+        let feedback = device
+            .try_get_render_node()
+            .ok()
+            .flatten()
+            .and_then(|node| {
+                DmabufFeedbackBuilder::new(node.dev_id(), formats.clone())
+                    .build()
+                    .ok()
+            });
+        if let Some(feedback) = feedback {
+            niri.dmabuf_state
+                .create_global_with_default_feedback::<State>(&niri.display_handle, &feedback);
+        } else {
+            niri.dmabuf_state
+                .create_global::<State>(&niri.display_handle, formats);
+        }
+        info!("headless renderer: advertised hardware DMA-BUF formats");
+        true
+    }
+
     /// Add an output for testing (uses lowercase naming like `headless-1`).
     /// This is kept for backwards compatibility with tests.
     pub fn add_output(&mut self, niri: &mut Niri, n: u8, size: (u16, u16)) {
@@ -687,6 +727,8 @@ mod remote_tests {
             .unwrap();
         assert!(software);
         assert_eq!(headless.primary_render_node(), None);
+        // Applications keep SHM: a software renderer gets no DMA-BUF global.
+        assert!(!headless.create_dmabuf_global(&mut state.niri));
     }
 
     #[test]
