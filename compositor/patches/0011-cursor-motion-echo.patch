diff --git a/src/handlers/image_copy_capture.rs b/src/handlers/image_copy_capture.rs
index 81f9fd12..2037ef52 100644
--- a/src/handlers/image_copy_capture.rs
+++ b/src/handlers/image_copy_capture.rs
@@ -59,6 +59,37 @@ pub struct ImageCopyCursorSession {
     pub stream_id: CastStreamId,
     /// Credentials of the capturing client, if known.
     pub credentials: Option<Credentials>,
+    /// Cursor position last given to the session (smithay deduplicates against it).
+    pub reported_pos: Option<Point<i32, BufferCoords>>,
+    /// Cursor position the client knows: the reported one, or where the client's own virtual
+    /// pointer moved the cursor since.
+    pub known_pos: Option<Point<i32, BufferCoords>>,
+}
+
+impl ImageCopyCursorSession {
+    /// Sends the cursor position (`None` to leave) unless the client already knows it.
+    ///
+    /// `own_motion` means that the session's client moved the cursor to `pos` with its own virtual
+    /// pointer. Such a client, like a remote desktop server, already shows its local cursor
+    /// there, and echoing older positions back would warp that cursor back while it moves. Enter
+    /// and leave are always sent.
+    pub fn set_cursor_pos(&mut self, pos: Option<Point<i32, BufferCoords>>, own_motion: bool) {
+        if own_motion && pos.is_some() && self.known_pos.is_some() {
+            self.known_pos = pos;
+            return;
+        }
+        if pos == self.known_pos {
+            return;
+        }
+        if pos.is_some() && pos == self.reported_pos {
+            // The client moved its cursor away since this was reported, and smithay would drop
+            // the same position, so report it again after a leave.
+            self.session.set_cursor_pos(None);
+        }
+        self.session.set_cursor_pos(pos);
+        self.reported_pos = pos;
+        self.known_pos = pos;
+    }
 }
 
 /// Credentials for the client which created a capture session.
