diff --git a/src/tests/cursor_capture.rs b/src/tests/cursor_capture.rs
new file mode 100644
index 00000000..a1ded514
--- /dev/null
+++ b/src/tests/cursor_capture.rs
@@ -0,0 +1,278 @@
+//! ext-image-copy-capture cursor sessions as used by the Niri-RDP remote desktop bridge.
+//!
+//! The bridge moves the cursor with its own virtual pointer and draws the cursor on the remote
+//! client from a cursor session on the same connection. Positions that its own pointer caused must
+//! not come back, or the remote client's local cursor would warp back while it moves. Positions
+//! from anything else (compositor warps, other pointers) and enter/leave still have to.
+
+use std::sync::{Arc, Mutex};
+
+use smithay::reexports::wayland_protocols::ext::image_capture_source::v1::client::ext_image_capture_source_v1::ExtImageCaptureSourceV1;
+use smithay::reexports::wayland_protocols::ext::image_capture_source::v1::client::ext_output_image_capture_source_manager_v1::ExtOutputImageCaptureSourceManagerV1;
+use smithay::reexports::wayland_protocols::ext::image_copy_capture::v1::client::ext_image_copy_capture_cursor_session_v1::{self, ExtImageCopyCaptureCursorSessionV1};
+use smithay::reexports::wayland_protocols::ext::image_copy_capture::v1::client::ext_image_copy_capture_manager_v1::ExtImageCopyCaptureManagerV1;
+use smithay::reexports::wayland_protocols::ext::image_copy_capture::v1::client::ext_image_copy_capture_session_v1::{self, ExtImageCopyCaptureSessionV1};
+use smithay::reexports::wayland_protocols_wlr::virtual_pointer::v1::client::zwlr_virtual_pointer_v1::ZwlrVirtualPointerV1;
+use smithay::utils::Point;
+use wayland_client::protocol::wl_pointer::WlPointer;
+use wayland_client::protocol::wl_registry::{self, WlRegistry};
+use wayland_client::{Connection, Dispatch, QueueHandle, WEnum};
+
+use crate::niri::PointerVisibility;
+use crate::tests::client::{self, ClientId};
+use crate::tests::fixture::Fixture;
+
+type Log = Arc<Mutex<Vec<String>>>;
+
+struct Capture {
+    log: Log,
+    _session: ExtImageCopyCaptureCursorSessionV1,
+}
+
+impl Capture {
+    fn take(&self) -> Vec<String> {
+        std::mem::take(&mut *self.log.lock().unwrap())
+    }
+}
+
+fn set_up() -> Fixture {
+    let mut f = Fixture::new();
+    f.add_output(1, (1920, 1080));
+    f
+}
+
+fn add_client(f: &mut Fixture) -> ClientId {
+    let id = f.add_client();
+    // Output names arrive after the first roundtrip.
+    f.roundtrip(id);
+    id
+}
+
+/// Binds a global that the shared test client does not bind itself.
+fn bind<I: wayland_client::Proxy + 'static>(f: &mut Fixture, id: ClientId) -> I
+where
+    client::State: Dispatch<I, ()>,
+{
+    let client = f.client(id);
+    let global = client
+        .state
+        .globals
+        .iter()
+        .find(|global| global.interface == I::interface().name)
+        .unwrap();
+    let (name, version) = (global.name, global.version.min(I::interface().version));
+    let registry = client.display.get_registry(&client.qh, Registry);
+    registry.bind(name, version, &client.qh, ())
+}
+
+/// A cursor session of output 1 for the seat pointer of this client.
+fn cursor_session(f: &mut Fixture, id: ClientId) -> Capture {
+    let sources: ExtOutputImageCaptureSourceManagerV1 = bind(f, id);
+    let manager: ExtImageCopyCaptureManagerV1 = bind(f, id);
+    let log = Log::default();
+    let client = f.client(id);
+    let output = client.output("headless-1");
+    let seat = client.state.seats.keys().next().unwrap().clone();
+    let pointer = seat.get_pointer(&client.qh, ());
+    let source = sources.create_source(&output, &client.qh, ());
+    let session = manager.create_pointer_cursor_session(&source, &pointer, &client.qh, log.clone());
+    session.get_capture_session(&client.qh, log.clone());
+    f.double_roundtrip(id);
+    Capture {
+        log,
+        _session: session,
+    }
+}
+
+/// A virtual pointer mapped to output 1, created for the client's seat like the bridge does.
+fn virtual_pointer(f: &mut Fixture, id: ClientId, with_seat: bool) -> ZwlrVirtualPointerV1 {
+    let client = f.client(id);
+    let output = client.output("headless-1");
+    let seat = client.state.seats.keys().next().unwrap().clone();
+    let manager = client.state.virtual_pointer_manager.as_ref().unwrap();
+    let seat = with_seat.then_some(&seat);
+    manager.create_virtual_pointer_with_output(seat, Some(&output), &client.qh, ())
+}
+
+fn move_to(f: &mut Fixture, id: ClientId, pointer: &ZwlrVirtualPointerV1, x: u32, y: u32) {
+    pointer.motion_absolute(0, x, y, 1920, 1080);
+    pointer.frame();
+    f.double_roundtrip(id);
+}
+
+fn warp(f: &mut Fixture, id: ClientId, x: f64, y: f64) {
+    f.niri_state().move_cursor(Point::from((x, y)));
+    f.double_roundtrip(id);
+}
+
+#[test]
+fn cursor_session_reports_position_and_offers_argb8888_shm() {
+    let mut f = set_up();
+    let bridge = add_client(&mut f);
+    let pointer = virtual_pointer(&mut f, bridge, true);
+    move_to(&mut f, bridge, &pointer, 100, 200);
+
+    let capture = cursor_session(&mut f, bridge);
+    let events = capture.take();
+    // A new session always gets the current position, also when the client moved there itself.
+    let position = events.iter().position(|e| e == "position 100 200").unwrap();
+    assert_eq!(events[..position], ["enter", "hotspot"]);
+    // Cursor images are SHM ARGB8888 only; cursor constraints never offer DMA-BUF.
+    assert!(events.contains(&"shm_format Argb8888".to_owned()));
+    assert!(events.iter().any(|e| e.starts_with("buffer_size ")));
+    assert!(!events.iter().any(|e| e.starts_with("dmabuf")));
+    assert_eq!(events.last().unwrap(), "done");
+}
+
+#[test]
+fn own_virtual_pointer_motion_is_not_echoed() {
+    let mut f = set_up();
+    let bridge = add_client(&mut f);
+    let other = add_client(&mut f);
+    let pointer = virtual_pointer(&mut f, bridge, true);
+    let other_pointer = virtual_pointer(&mut f, other, true);
+    let capture = cursor_session(&mut f, bridge);
+    let observer = cursor_session(&mut f, other);
+    capture.take();
+    observer.take();
+
+    move_to(&mut f, bridge, &pointer, 300, 400);
+    move_to(&mut f, bridge, &pointer, 310, 405);
+    f.roundtrip(other);
+    assert!(capture.take().is_empty());
+    // Other clients still see the motion.
+    assert_eq!(observer.take().last().unwrap(), "position 310 405");
+
+    // The bridge's last motion stays acknowledged across idle iterations.
+    f.double_roundtrip(bridge);
+    assert!(capture.take().is_empty());
+
+    // Compositor warps (e.g. warp-mouse-to-focus) and other pointers still move the cursor.
+    warp(&mut f, bridge, 500., 600.);
+    assert_eq!(capture.take(), ["position 500 600"]);
+    move_to(&mut f, other, &other_pointer, 700, 800);
+    f.double_roundtrip(bridge);
+    assert_eq!(capture.take(), ["position 700 800"]);
+    move_to(&mut f, bridge, &pointer, 710, 800);
+    assert!(capture.take().is_empty());
+}
+
+#[test]
+fn warp_to_the_last_reported_position_is_reported_again() {
+    let mut f = set_up();
+    let bridge = add_client(&mut f);
+    let pointer = virtual_pointer(&mut f, bridge, true);
+    warp(&mut f, bridge, 50., 60.);
+    let capture = cursor_session(&mut f, bridge);
+    assert!(capture.take().contains(&"position 50 60".to_owned()));
+
+    move_to(&mut f, bridge, &pointer, 900, 500);
+    assert!(capture.take().is_empty());
+
+    // Smithay already sent (50, 60) and deduplicates it, but the client is elsewhere now.
+    warp(&mut f, bridge, 50., 60.);
+    assert_eq!(
+        capture.take(),
+        ["leave", "enter", "hotspot", "position 50 60"]
+    );
+}
+
+#[test]
+fn visibility_changes_are_reported_for_own_motion() {
+    let mut f = set_up();
+    let bridge = add_client(&mut f);
+    let pointer = virtual_pointer(&mut f, bridge, true);
+    move_to(&mut f, bridge, &pointer, 100, 100);
+    let capture = cursor_session(&mut f, bridge);
+    capture.take();
+
+    // Hidden by niri (hide-when-typing): leave.
+    f.niri().pointer_visibility = PointerVisibility::Hidden;
+    f.double_roundtrip(bridge);
+    assert_eq!(capture.take(), ["leave"]);
+
+    // Own motion shows the pointer again: enter must not be suppressed.
+    move_to(&mut f, bridge, &pointer, 120, 130);
+    assert_eq!(capture.take(), ["enter", "hotspot", "position 120 130"]);
+    move_to(&mut f, bridge, &pointer, 140, 150);
+    assert!(capture.take().is_empty());
+}
+
+#[test]
+fn virtual_pointer_without_seat_is_echoed() {
+    let mut f = set_up();
+    let bridge = add_client(&mut f);
+    // Without a seat the owner of the virtual pointer is unknown.
+    let pointer = virtual_pointer(&mut f, bridge, false);
+    let capture = cursor_session(&mut f, bridge);
+    capture.take();
+
+    move_to(&mut f, bridge, &pointer, 300, 400);
+    assert_eq!(capture.take(), ["position 300 400"]);
+}
+
+struct Registry;
+
+impl Dispatch<WlRegistry, Registry> for client::State {
+    fn event(
+        _: &mut Self,
+        _: &WlRegistry,
+        _: wl_registry::Event,
+        _: &Registry,
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+    }
+}
+
+wayland_client::delegate_noop!(client::State: ignore WlPointer);
+wayland_client::delegate_noop!(client::State: ExtOutputImageCaptureSourceManagerV1);
+wayland_client::delegate_noop!(client::State: ExtImageCaptureSourceV1);
+wayland_client::delegate_noop!(client::State: ExtImageCopyCaptureManagerV1);
+
+impl Dispatch<ExtImageCopyCaptureCursorSessionV1, Log> for client::State {
+    fn event(
+        _: &mut Self,
+        _: &ExtImageCopyCaptureCursorSessionV1,
+        event: ext_image_copy_capture_cursor_session_v1::Event,
+        log: &Log,
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+        use ext_image_copy_capture_cursor_session_v1::Event;
+        let event = match event {
+            Event::Enter => "enter".to_owned(),
+            Event::Leave => "leave".to_owned(),
+            Event::Position { x, y } => format!("position {x} {y}"),
+            // The hotspot depends on the cursor theme.
+            Event::Hotspot { .. } => "hotspot".to_owned(),
+            _ => return,
+        };
+        log.lock().unwrap().push(event);
+    }
+}
+
+impl Dispatch<ExtImageCopyCaptureSessionV1, Log> for client::State {
+    fn event(
+        _: &mut Self,
+        _: &ExtImageCopyCaptureSessionV1,
+        event: ext_image_copy_capture_session_v1::Event,
+        log: &Log,
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+        use ext_image_copy_capture_session_v1::Event;
+        let event = match event {
+            Event::BufferSize { width, height } => format!("buffer_size {width} {height}"),
+            Event::ShmFormat {
+                format: WEnum::Value(format),
+            } => format!("shm_format {format:?}"),
+            Event::DmabufDevice { .. } => "dmabuf_device".to_owned(),
+            Event::DmabufFormat { .. } => "dmabuf_format".to_owned(),
+            Event::Done => "done".to_owned(),
+            Event::Stopped => "stopped".to_owned(),
+            _ => return,
+        };
+        log.lock().unwrap().push(event);
+    }
+}
