+#[test]
+fn input_method_forwarded_keys_bypass_its_grab_without_updating_xkb() {
+    let (mut f, id, surface) = set_up();
+    let bridge = f.add_client();
+    let keyboard = virtual_keyboard(&mut f, bridge);
+    send_keymap(&keyboard, &seat_keymap(&mut f));
+    f.roundtrip(bridge);
+    let mut ime = InputMethod::new(&mut f);
+
+    // The bridge's own XKB state follows CapsLock, so its masks lock it too.
+    for key in [KEY_CAPSLOCK, KEY_A] {
+        keyboard.key(0, key, 1);
+        keyboard.modifiers(0, 0, MOD_LOCK, 0);
+        keyboard.key(0, key, 0);
+        keyboard.modifiers(0, 0, MOD_LOCK, 0);
+    }
+    f.roundtrip(bridge);
+    f.roundtrip(ime.id);
+    assert_eq!(
+        ime.keys(),
+        [(KEY_CAPSLOCK, 1), (KEY_CAPSLOCK, 0), (KEY_A, 1), (KEY_A, 0)]
+    );
+    assert!(keys(&mut f, id, &surface).is_empty());
+    assert!(caps_lock(&mut f));
+
+    ime.forward_all(&mut f);
+    f.roundtrip(bridge);
+    f.roundtrip(id);
+
+    // Forwarded keys reach the focus once, are not looped back into the grab, and do not apply
+    // CapsLock a second time.
+    assert_eq!(ime.keys().len(), 4);
+    assert_eq!(
+        keys(&mut f, id, &surface),
+        [
+            "key pressed: 58",
+            "key released: 58",
+            "key pressed: 30",
+            "key released: 30",
+        ]
+    );
+    assert!(caps_lock(&mut f));
+}
