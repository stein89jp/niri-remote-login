+impl Dispatch<ZwpInputMethodKeyboardGrabV2, Arc<Mutex<Vec<GrabEvent>>>> for client::State {
+    fn event(
+        _: &mut Self,
+        _: &ZwpInputMethodKeyboardGrabV2,
+        event: zwp_input_method_keyboard_grab_v2::Event,
+        log: &Arc<Mutex<Vec<GrabEvent>>>,
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+        let event = match event {
+            zwp_input_method_keyboard_grab_v2::Event::Keymap { fd, size, .. } => {
+                let mut file = File::from(fd);
+                file.seek(SeekFrom::Start(0)).unwrap();
+                let mut text = String::new();
+                file.take(u64::from(size))
+                    .read_to_string(&mut text)
+                    .unwrap();
+                GrabEvent::Keymap(text.trim_end_matches('\0').to_owned())
+            }
+            zwp_input_method_keyboard_grab_v2::Event::Modifiers {
+                mods_depressed,
+                mods_latched,
+                mods_locked,
+                group,
+                ..
+            } => GrabEvent::Modifiers([mods_depressed, mods_latched, mods_locked, group]),
+            zwp_input_method_keyboard_grab_v2::Event::Key { key, state, .. } => {
+                GrabEvent::Key(key, u32::from(state))
+            }
+            _ => return,
+        };
+        log.lock().unwrap().push(event);
+    }
+}
+
+impl Dispatch<WlKeyboard, Arc<Mutex<Typed>>> for client::State {
+    fn event(
+        _: &mut Self,
+        _: &WlKeyboard,
+        event: wl_keyboard::Event,
+        typed: &Arc<Mutex<Typed>>,
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+        let mut typed = typed.lock().unwrap();
+        match event {
+            wl_keyboard::Event::Keymap { fd, size, .. } => {
+                let mut text = String::new();
+                File::from(fd)
+                    .take(u64::from(size))
+                    .read_to_string(&mut text)
+                    .unwrap();
+                typed.keymap = Some(text.trim_end_matches('\0').to_owned());
+            }
+            wl_keyboard::Event::Key {
+                key,
+                state: wayland_client::WEnum::Value(wl_keyboard::KeyState::Pressed),
+                ..
+            } => {
+                let context = xkb::Context::new(xkb::CONTEXT_NO_FLAGS);
+                let keymap = xkb::Keymap::new_from_string(
+                    &context,
+                    typed.keymap.clone().unwrap(),
+                    xkb::KEYMAP_FORMAT_TEXT_V1,
+                    xkb::KEYMAP_COMPILE_NO_FLAGS,
+                )
+                .unwrap();
+                let text = xkb::State::new(&keymap).key_get_utf8((key + 8).into());
+                typed.text.push_str(&text);
+            }
+            _ => (),
+        }
+    }
+}
