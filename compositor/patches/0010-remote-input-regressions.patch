+/// What a focused client decodes from its keymap and key events (like `lab/dynamic-app`).
+#[derive(Default)]
+struct Typed {
+    keymap: Option<String>,
+    text: String,
+}
+
+/// A second `wl_keyboard` in the window's client that records the text it would type.
+fn typed(f: &mut Fixture, id: ClientId) -> Arc<Mutex<Typed>> {
+    let typed = Arc::new(Mutex::new(Typed::default()));
+    let client = f.client(id);
+    let seat = client.state.seats.keys().next().unwrap().clone();
+    let _keyboard = seat.get_keyboard(&client.qh, typed.clone());
+    f.roundtrip(id);
+    typed
+}
