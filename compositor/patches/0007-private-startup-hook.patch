+//! Activation preparation for private remote (Niri-RDP) headless sessions.
+
+use std::process::Command;
+use std::time::{Duration, Instant};
+
+use calloop::EventLoop;
+
+use crate::niri::State;
+use crate::utils::spawning::CHILD_ENV;
+
+/// Fixed helper that publishes the activation environment to the session's private D-Bus bus.
+pub const PREPARE_COMMAND: &str = "/usr/lib/niri-rdp/session-autostart";
+
+/// How [`prepare_private_session`] ended.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum PrepareOutcome {
+    Succeeded,
+    Failed,
+    TimedOut,
+    WaitFailed,
+    SpawnFailed,
+}
+
+/// Runs a private session's activation preparation before startup applications are spawned.
+///
+/// The command gets the configured child environment. While it runs, the event loop keeps
+/// dispatching, because input methods need Wayland roundtrips to finish loading. A command that
+/// outlives `timeout` is killed. Failures are logged and startup continues.
+pub fn prepare_private_session(
+    event_loop: &mut EventLoop<'static, State>,
+    state: &mut State,
+    mut command: Command,
+    timeout: Duration,
+) -> Result<PrepareOutcome, calloop::Error> {
+    for variable in &CHILD_ENV.read().unwrap().0 {
+        if let Some(value) = &variable.value {
+            command.env(&variable.name, value);
+        } else {
+            command.env_remove(&variable.name);
+        }
+    }
+
+    let mut child = match command.spawn() {
+        Ok(child) => child,
+        Err(error) => {
+            warn!("could not prepare private desktop activation: {error}");
+            return Ok(PrepareOutcome::SpawnFailed);
+        }
+    };
+
+    let deadline = Instant::now() + timeout;
+    let outcome = loop {
+        match child.try_wait() {
+            Ok(Some(status)) => {
+                if status.success() {
+                    return Ok(PrepareOutcome::Succeeded);
+                }
+                warn!("private desktop activation preparation failed: {status}");
+                return Ok(PrepareOutcome::Failed);
+            }
+            Ok(None) if Instant::now() < deadline => {
+                // Input methods need Wayland roundtrips to finish loading.
+                // Keep the display responsive while holding startup apps.
+                if let Err(error) = event_loop.dispatch(Some(Duration::from_millis(10)), state) {
+                    let _ = child.kill();
+                    let _ = child.wait();
+                    return Err(error);
+                }
+                state.refresh_and_flush_clients();
+            }
+            Ok(None) => {
+                warn!("private desktop activation preparation timed out");
+                break PrepareOutcome::TimedOut;
+            }
+            Err(error) => {
+                warn!("could not wait for private desktop activation: {error}");
+                break PrepareOutcome::WaitFailed;
+            }
+        }
+    };
+
+    let _ = child.kill();
+    let _ = child.wait();
+    Ok(outcome)
+}
+
+#[cfg(test)]
+mod tests {
+    use std::cell::Cell;
+    use std::rc::Rc;
+
+    use calloop::timer::{TimeoutAction, Timer};
+    use niri_config::Config;
+    use smithay::reexports::wayland_server::Display;
+
+    use super::*;
+
+    fn prepare(command: Command, timeout: Duration) -> (PrepareOutcome, bool) {
+        let mut event_loop = EventLoop::<State>::try_new().unwrap();
+        let mut state = State::new(
+            Config::default(),
+            event_loop.handle(),
+            event_loop.get_signal(),
+            Display::new().unwrap(),
+            true,
+            false,
+            false,
+        )
+        .unwrap();
+
+        // Records whether the event loop kept dispatching while the command ran.
+        let dispatched = Rc::new(Cell::new(false));
+        let flag = dispatched.clone();
+        event_loop
+            .handle()
+            .insert_source(
+                Timer::from_duration(Duration::from_millis(1)),
+                move |_, _, _| {
+                    flag.set(true);
+                    TimeoutAction::Drop
+                },
+            )
+            .unwrap();
+
+        let outcome = prepare_private_session(&mut event_loop, &mut state, command, timeout);
+        (outcome.unwrap(), dispatched.get())
+    }
+
+    fn sh(script: &str) -> Command {
+        let mut command = Command::new("/bin/sh");
+        command.args(["-c", script]);
+        command
+    }
+
+    #[test]
+    fn preparation_dispatches_the_event_loop_until_the_helper_exits() {
+        let (outcome, dispatched) = prepare(sh("sleep 0.2"), Duration::from_secs(15));
+        assert_eq!(outcome, PrepareOutcome::Succeeded);
+        assert!(dispatched);
+    }
+
+    #[test]
+    fn failed_or_missing_helpers_do_not_stop_startup() {
+        let (outcome, _) = prepare(sh("exit 3"), Duration::from_secs(15));
+        assert_eq!(outcome, PrepareOutcome::Failed);
+
+        let missing = Command::new("/nonexistent/niri-rdp/session-autostart");
+        let (outcome, dispatched) = prepare(missing, Duration::from_secs(15));
+        assert_eq!(outcome, PrepareOutcome::SpawnFailed);
+        assert!(!dispatched);
+    }
+
+    #[test]
+    fn helper_is_killed_after_the_deadline() {
+        let start = Instant::now();
+        let (outcome, dispatched) = prepare(sh("exec sleep 30"), Duration::from_millis(200));
+        assert_eq!(outcome, PrepareOutcome::TimedOut);
+        assert!(dispatched);
+        assert!(start.elapsed() < Duration::from_secs(10));
+    }
+}
