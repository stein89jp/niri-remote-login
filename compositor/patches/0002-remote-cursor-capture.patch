diff --git a/src/protocols/remote_cursor.rs b/src/protocols/remote_cursor.rs
new file mode 100644
--- /dev/null
+++ b/src/protocols/remote_cursor.rs
@@ -0,0 +1,247 @@
+//! Private bounded cursor capture, exposed only in headless remote sessions.
+use super::raw::remote_cursor::server::{
+    niri_rdp_cursor_manager_v1::{self, NiriRdpCursorManagerV1},
+    niri_rdp_cursor_v1::{self, NiriRdpCursorV1},
+};
+use crate::{
+    niri::{ClientState, Niri, State},
+    render_helpers::render_to_vec,
+};
+use smithay::{
+    backend::{
+        allocator::Fourcc,
+        renderer::{
+            element::{
+                utils::{Relocate, RelocateRenderElement},
+                Element, Id,
+            },
+            gles::GlesRenderer,
+            utils::CommitCounter,
+        },
+    },
+    output::Output,
+    reexports::wayland_server::{
+        Client, DataInit, Dispatch, DisplayHandle, GlobalDispatch, New, Resource,
+    },
+    utils::{Physical, Point, Rectangle, Scale, SealedFile, Transform},
+};
+use std::os::fd::AsFd;
+
+#[derive(Default)]
+pub struct RemoteCursorState {
+    subscriptions: Vec<Subscription>,
+}
+struct Subscription {
+    cursor: NiriRdpCursorV1,
+    output: Output,
+    pixels: Vec<u8>,
+    geometry: (u32, u32, u32, u32),
+    position: Option<(u32, u32)>,
+    hidden: bool,
+    unsupported: bool,
+    signature: Vec<(Id, CommitCounter, Rectangle<i32, Physical>)>,
+}
+impl GlobalDispatch<NiriRdpCursorManagerV1, ()> for State {
+    fn bind(
+        _: &mut Self,
+        _: &DisplayHandle,
+        _: &Client,
+        resource: New<NiriRdpCursorManagerV1>,
+        _: &(),
+        init: &mut DataInit<'_, Self>,
+    ) {
+        init.init(resource, ());
+    }
+    fn can_view(client: Client, _: &()) -> bool {
+        client
+            .get_data::<ClientState>()
+            .is_some_and(|data| !data.restricted)
+    }
+}
+impl Dispatch<NiriRdpCursorManagerV1, ()> for State {
+    fn request(
+        state: &mut Self,
+        _: &Client,
+        _: &NiriRdpCursorManagerV1,
+        request: niri_rdp_cursor_manager_v1::Request,
+        _: &(),
+        _: &DisplayHandle,
+        init: &mut DataInit<'_, Self>,
+    ) {
+        if let niri_rdp_cursor_manager_v1::Request::GetCursor { id, output } = request {
+            let cursor = init.init(id, ());
+            state
+                .niri
+                .remote_cursor_state
+                .subscriptions
+                .retain(|entry| entry.cursor.is_alive());
+            if let Some(output) = Output::from_resource(&output)
+                .filter(|_| state.niri.remote_cursor_state.subscriptions.len() < 16)
+            {
+                state
+                    .niri
+                    .remote_cursor_state
+                    .subscriptions
+                    .push(Subscription {
+                        cursor,
+                        output: output.clone(),
+                        pixels: Vec::new(),
+                        geometry: (0, 0, 0, 0),
+                        position: None,
+                        hidden: false,
+                        unsupported: false,
+                        signature: Vec::new(),
+                    });
+                state.niri.queue_redraw(&output);
+            } else {
+                cursor.unsupported();
+            }
+        }
+    }
+}
+impl Dispatch<NiriRdpCursorV1, ()> for State {
+    fn request(
+        _: &mut Self,
+        _: &Client,
+        _: &NiriRdpCursorV1,
+        _: niri_rdp_cursor_v1::Request,
+        _: &(),
+        _: &DisplayHandle,
+        _: &mut DataInit<'_, Self>,
+    ) {
+    }
+}
+impl Niri {
+    pub fn render_remote_cursor(&mut self, renderer: &mut GlesRenderer, output: &Output) {
+        self.remote_cursor_state
+            .subscriptions
+            .retain(|entry| entry.cursor.is_alive());
+        if !self
+            .remote_cursor_state
+            .subscriptions
+            .iter()
+            .any(|entry| &entry.output == output)
+        {
+            return;
+        }
+        let mut state = std::mem::take(&mut self.remote_cursor_state);
+        let output_scale: Scale<f64> = output.current_scale().fractional_scale().into();
+        let Some(geometry) = self.global_space.output_geometry(output) else {
+            self.remote_cursor_state = state;
+            return;
+        };
+        let point = self.seat.get_pointer().unwrap().current_location() - geometry.loc.to_f64();
+        let point: Point<i32, Physical> = point.to_physical_precise_round(output_scale);
+        let size = output.current_mode().unwrap().size;
+        let position = (
+            point.x.clamp(0, size.w - 1) as u32,
+            point.y.clamp(0, size.h - 1) as u32,
+        );
+        let mut elements = Vec::new();
+        if self.pointer_visibility.is_visible() {
+            self.render_pointer(renderer, output, &mut |element| elements.push(element));
+        }
+        let bbox = elements
+            .iter()
+            .map(|element| element.geometry(output_scale))
+            .reduce(|a, b| a.merge(b));
+        let mut rendered = None;
+        let mut shape_unchanged = false;
+        let mut signature = Vec::new();
+        let mut unsupported = false;
+        if let Some(bbox) = bbox {
+            if bbox.size.w <= 0 || bbox.size.h <= 0 || bbox.size.w > 384 || bbox.size.h > 384 {
+                unsupported = true;
+            } else {
+                let hot_x = (point.x - bbox.loc.x).clamp(0, bbox.size.w - 1) as u32;
+                let hot_y = (point.y - bbox.loc.y).clamp(0, bbox.size.h - 1) as u32;
+                let geometry = (bbox.size.w as u32, bbox.size.h as u32, hot_x, hot_y);
+                signature = elements
+                    .iter()
+                    .map(|element| {
+                        let mut rect = element.geometry(output_scale);
+                        rect.loc -= bbox.loc;
+                        (element.id().clone(), element.current_commit(), rect)
+                    })
+                    .collect();
+                shape_unchanged = state
+                    .subscriptions
+                    .iter()
+                    .filter(|entry| &entry.output == output)
+                    .all(|entry| {
+                        !entry.hidden
+                            && !entry.unsupported
+                            && entry.signature == signature
+                            && entry.geometry == geometry
+                    });
+                if !shape_unchanged {
+                    let offset = Point::<i32, Physical>::from((-bbox.loc.x, -bbox.loc.y));
+                    let moved: Vec<_> = elements
+                        .into_iter()
+                        .map(|element| {
+                            RelocateRenderElement::from_element(element, offset, Relocate::Relative)
+                        })
+                        .collect();
+                    match render_to_vec(
+                        renderer,
+                        bbox.size,
+                        output_scale,
+                        Transform::Normal,
+                        Fourcc::Abgr8888,
+                        moved.iter().rev(),
+                    ) {
+                        Ok(pixels) => {
+                            rendered = Some((pixels, geometry));
+                        }
+                        Err(_) => unsupported = true,
+                    }
+                }
+            }
+        }
+        for entry in state
+            .subscriptions
+            .iter_mut()
+            .filter(|entry| &entry.output == output)
+        {
+            if entry.position != Some(position) {
+                entry.cursor.position(position.0, position.1);
+                entry.position = Some(position);
+            }
+            if unsupported {
+                if !entry.unsupported {
+                    entry.cursor.unsupported();
+                    entry.unsupported = true;
+                }
+            } else if let Some((pixels, geometry)) = &rendered {
+                if entry.hidden
+                    || entry.unsupported
+                    || &entry.pixels != pixels
+                    || &entry.geometry != geometry
+                {
+                    if let Ok(file) = SealedFile::with_data(c"niri-rdp-cursor", pixels) {
+                        entry.cursor.shape(
+                            file.as_fd(),
+                            geometry.0,
+                            geometry.1,
+                            geometry.2,
+                            geometry.3,
+                        );
+                        entry.pixels.clone_from(pixels);
+                        entry.signature.clone_from(&signature);
+                        entry.geometry = *geometry;
+                        entry.hidden = false;
+                        entry.unsupported = false;
+                    } else {
+                        entry.cursor.unsupported();
+                        entry.unsupported = true;
+                    }
+                }
+            } else if !shape_unchanged && (!entry.hidden || entry.unsupported) {
+                entry.cursor.hidden();
+                entry.hidden = true;
+                entry.unsupported = false;
+            }
+        }
+        self.remote_cursor_state = state;
+    }
+}
diff --git a/resources/niri-rdp-cursor-v1.xml b/resources/niri-rdp-cursor-v1.xml
new file mode 100644
--- /dev/null
+++ b/resources/niri-rdp-cursor-v1.xml
@@ -0,0 +1,30 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<protocol name="niri_rdp_cursor_v1">
+  <copyright>Copyright 2026 Niri-RDP contributors. SPDX-License-Identifier: MIT</copyright>
+  <interface name="niri_rdp_cursor_manager_v1" version="1">
+    <description summary="private remote cursor capture">
+      Available only on the isolated headless compositor to unrestricted clients.
+      Cursor coordinates and sizes are physical output pixels. RGBA images are
+      premultiplied, top-down, tightly packed; files are sealed and bounded to
+      384x384. This extension is private to the maintained Niri-RDP pin.
+    </description>
+    <request name="destroy" type="destructor"/>
+    <request name="get_cursor">
+      <arg name="id" type="new_id" interface="niri_rdp_cursor_v1"/>
+      <arg name="output" type="object" interface="wl_output"/>
+    </request>
+  </interface>
+  <interface name="niri_rdp_cursor_v1" version="1">
+    <request name="destroy" type="destructor"/>
+    <event name="position"><arg name="x" type="uint"/><arg name="y" type="uint"/></event>
+    <event name="shape">
+      <arg name="fd" type="fd"/><arg name="width" type="uint"/><arg name="height" type="uint"/>
+      <arg name="hot_x" type="uint"/><arg name="hot_y" type="uint"/>
+    </event>
+    <event name="hidden"/>
+    <event name="unsupported"><description summary="retain embedded cursor">
+      The output/cursor cannot be represented. Clients must retain embedded
+      capture until a later valid shape or hidden event. No pixels follow.
+    </description></event>
+  </interface>
+</protocol>
